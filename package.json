{
  "name": "nexo-crm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:isolation": "pnpm --filter @nexo/api test:isolation",
    "db:generate": "pnpm --filter @nexo/database generate",
    "db:migrate": "pnpm --filter @nexo/database migrate",
    "db:deploy": "pnpm --filter @nexo/database deploy",
    "db:seed": "pnpm --filter @nexo/database seed",
    "db:reset": "pnpm --filter @nexo/database reset",
    "db:studio": "pnpm --filter @nexo/database studio",
    "docker:dev": "docker compose --env-file .env -f infra/compose.yml up -d",
    "docker:dev:down": "docker compose --env-file .env -f infra/compose.yml down",
    "docker:logs": "docker compose --env-file .env -f infra/compose.yml logs -f",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@nexo/config": "workspace:*",
    "prettier": "3.9.6",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  }
}
