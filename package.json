{
  "name": "nexo-crm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:isolation": "pnpm --filter @nexo/database run test:isolation",
    "db:generate": "pnpm --filter @nexo/database run generate",
    "db:migrate": "pnpm --filter @nexo/database run migrate",
    "db:migration:new": "pnpm --filter @nexo/database run migration:new",
    "db:deploy": "pnpm --filter @nexo/database run deploy",
    "db:seed": "pnpm --filter @nexo/database run seed",
    "db:reset": "pnpm --filter @nexo/database run reset",
    "db:studio": "pnpm --filter @nexo/database run studio",
    "docker:dev": "docker compose --env-file .env -f infra/compose.yml up -d",
    "docker:dev:down": "docker compose --env-file .env -f infra/compose.yml down",
    "docker:logs": "docker compose --env-file .env -f infra/compose.yml logs -f",
    "format": "turbo run build --filter=@nexo/design --output-logs=errors-only && prettier --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "format:check": "turbo run build --filter=@nexo/design --output-logs=errors-only && prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck",
    "ci:local": "bash infra/scripts/ci-local.sh"
  },
  "devDependencies": {
    "@nexo/config": "workspace:*",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  }
}
