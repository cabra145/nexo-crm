{
  "name": "@nexo/storage",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts",
    "ensure-bucket": "node --env-file-if-exists=../../.env --import tsx scripts/ensure-bucket.ts",
    "clean": "rm -rf dist node_modules .turbo",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/s3-request-presigner": "3.1132.0"
  },
  "devDependencies": {
    "@nexo/config": "workspace:*",
    "@nexo/contracts": "workspace:*",
    "@types/node": "26.5.1",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ]
}
