{
  "name": "@nexo/design",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.ts",
    "./tokens": "./src/tokens.ts",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "node --import tsx scripts/build-theme.ts",
    "dev": "node --watch-path=src --watch-preserve-output --import tsx scripts/build-theme.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@nexo/config": "workspace:*",
    "@types/node": "26.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
