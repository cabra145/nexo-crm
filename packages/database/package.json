{
  "name": "@nexo/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "generate": "prisma generate",
    "prisma": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js",
    "create-app-role": "node --env-file-if-exists=../../.env scripts/create-app-role.mjs",
    "migrate": "pnpm run prisma migrate dev && pnpm run sql",
    "deploy": "pnpm run prisma migrate deploy && pnpm run sql",
    "sql": "node --env-file-if-exists=../../.env scripts/apply-sql.mjs",
    "rls": "node --env-file-if-exists=../../.env scripts/apply-sql.mjs 01_rls.sql",
    "verify-rls": "node --env-file-if-exists=../../.env scripts/verify-rls.mjs",
    "test:isolation": "node --env-file-if-exists=../../.env scripts/test-isolation.mjs",
    "seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts",
    "reset": "pnpm run prisma migrate reset --force --skip-seed && pnpm run sql && pnpm run seed",
    "studio": "pnpm run prisma studio",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@nexo/config": "workspace:*",
    "@types/node": "26.5.1",
    "eslint": "9.39.5",
    "pg": "8.23.0",
    "prisma": "5.22.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ]
}
