model Pipeline {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(80)
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int     @default(0) @map("sort_order")

  stages PipelineStage[]
  deals  Deal[]

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  @@unique([tenantId, name])
  @@index([tenantId, archivedAt])
  @@map("pipeline")
}

/// Las siete etapas por defecto (Nuevo → Ganado/Perdido) se crean con cada
/// empresa, pero son editables: cada negocio tiene su propio embudo.
model PipelineStage {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name  String    @db.VarChar(60)
  type  StageType @default(OPEN)
  color String    @default("#6B7280") @db.VarChar(9)

  /// Probabilidad por defecto al entrar en la etapa. La previsión ponderada
  /// usa la del trato, no ésta; ésta sólo la precarga.
  probability Int @default(0)

  position Float @default(1000)

  /// Días tras los cuales un trato en esta etapa se marca como estancado.
  rottingDays Int? @map("rotting_days")

  deals   Deal[]
  history DealStageHistory[]

  @@unique([pipelineId, name])
  @@index([tenantId, pipelineId, position])
  @@map("pipeline_stage")
}

enum StageType {
  OPEN
  WON
  LOST
}

model Deal {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title String @db.VarChar(200)

  pipelineId String        @map("pipeline_id") @db.Uuid
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stageId    String        @map("stage_id") @db.Uuid
  stage      PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  value       Decimal @default(0) @db.Decimal(14, 2)
  currency    String  @default("USD") @db.Char(3)
  probability Int     @default(0)

  status          DealStatus @default(OPEN)
  expectedCloseAt DateTime?  @map("expected_close_at") @db.Date
  closedAt        DateTime?  @map("closed_at") @db.Timestamptz(6)

  lostReasonId   String?     @map("lost_reason_id") @db.Uuid
  lostReason     LostReason? @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  lostReasonNote String?     @map("lost_reason_note")

  /// Orden fraccional dentro de la columna del Kanban. Mover una tarjeta
  /// escribe UNA fila: se toma el punto medio entre sus dos vecinas y sólo se
  /// reequilibra la columna cuando el hueco se agota.
  position Float @default(1000)

  source String? @db.VarChar(80)
  custom Json    @default("{}") @db.JsonB

  /// Desnormalizado desde `deal_item` para poder ordenar y sumar sin join.
  itemsTotal Decimal @default(0) @map("items_total") @db.Decimal(14, 2)

  stageEnteredAt DateTime  @default(now()) @map("stage_entered_at") @db.Timestamptz(6)
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(6)

  items        DealItem[]
  stageHistory DealStageHistory[]
  notes        Note[]
  activities   Activity[]
  tasks        Task[]
  documents    Document[]
  fieldValues  CustomFieldValue[]
  events       Event[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, pipelineId, stageId, position])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, status, expectedCloseAt])
  @@index([tenantId, contactId])
  @@index([tenantId, deletedAt])
  @@map("deal")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

/// Cada movimiento entre etapas, con su duración. Sin esta tabla escribiéndose
/// desde el primer día, la métrica "tiempo medio en negociación" no existe
/// jamás — no se puede reconstruir a posteriori.
model DealStageHistory {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  dealId   String @map("deal_id") @db.Uuid
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  stageId     String        @map("stage_id") @db.Uuid
  stage       PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  fromStageId String?       @map("from_stage_id") @db.Uuid

  movedByUserId String?   @map("moved_by_user_id") @db.Uuid
  movedByType   ActorType @default(USER) @map("moved_by_type")

  enteredAt       DateTime  @default(now()) @map("entered_at") @db.Timestamptz(6)
  exitedAt        DateTime? @map("exited_at") @db.Timestamptz(6)
  /// Calculado al salir. Redundante con las fechas, pero evita aritmética de
  /// intervalos en cada consulta del panel comercial.
  durationSeconds Int?      @map("duration_seconds")

  @@index([tenantId, dealId, enteredAt])
  @@index([tenantId, stageId, enteredAt])
  @@map("deal_stage_history")
}

model Product {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sku         String? @db.VarChar(60)
  name        String  @db.VarChar(200)
  description String?

  unitPrice Decimal @default(0) @map("unit_price") @db.Decimal(14, 2)
  currency  String  @default("USD") @db.Char(3)
  unit      String  @default("unidad") @db.VarChar(30)

  taxRateId String?  @map("tax_rate_id") @db.Uuid
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  dealItems     DealItem[]
  documentItems DocumentItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, sku])
  @@index([tenantId, active, name])
  @@map("product")
}

model DealItem {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  dealId   String @map("deal_id") @db.Uuid
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Copia del nombre y precio en el momento de añadirlo: si el producto
  /// cambia de precio mañana, el trato de ayer no se reescribe solo.
  name      String  @db.VarChar(200)
  quantity  Decimal @default(1) @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(5, 2) // porcentaje
  total     Decimal @db.Decimal(14, 2)

  sortOrder Int @default(0) @map("sort_order")

  @@index([tenantId, dealId])
  @@map("deal_item")
}

model LostReason {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(120)
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  deals Deal[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("lost_reason")
}

// ============================================================================
//  DOMINIO 5 · CONVERSACIONES
//  Modelado genérico por canal desde el principio: añadir Instagram o correo
//  en el roadmap es integración, no migración.
// ============================================================================

model Channel {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type   ChannelType
  name   String        @db.VarChar(80)
  status ChannelStatus @default(PENDING)

  /// Identificador del canal en el proveedor. Para WhatsApp Cloud es el
  /// phone_number_id de Meta: es lo que permite resolver a qué empresa
  /// pertenece un webhook entrante.
  externalId String? @map("external_id") @db.VarChar(120)
  /// Número en E.164, para mostrar.
  displayId  String? @map("display_id") @db.VarChar(40)

  /// Credenciales cifradas con AES-256-GCM. NUNCA vuelven al cliente, ni
  /// enmascaradas desde la BD: la interfaz muestra sólo los últimos 4.
  credentialsEncrypted   String? @map("credentials_encrypted")
  /// Secreto de verificación del webhook, también cifrado.
  webhookSecretEncrypted String? @map("webhook_secret_encrypted")

  config Json @default("{}") @db.JsonB

  lastErrorAt      DateTime? @map("last_error_at") @db.Timestamptz(6)
  lastErrorMessage String?   @map("last_error_message")
  connectedAt      DateTime? @map("connected_at") @db.Timestamptz(6)

  conversations Conversation[]
  templates     WaTemplate[]
  messages      Message[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([type, externalId], map: "channel_provider_identity_key")
  @@index([tenantId, type, status])
  @@map("channel")
}

enum ChannelType {
  WHATSAPP_CLOUD
  EMAIL
  SMS
  INSTAGRAM
  MESSENGER
  WEBCHAT
}

enum ChannelStatus {
  PENDING
  CONNECTED
  ERROR
  DISABLED
}

/// Identidad de un contacto en un canal concreto (su número de WhatsApp, su
/// usuario de Instagram). Permite que un contacto tenga varias y que un
/// mensaje entrante encuentre a su persona.
model ContactIdentity {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  type  ChannelType
  /// Para WhatsApp: el wa_id que devuelve Meta, en E.164 sin el '+'.
  value String      @db.VarChar(120)

  verified Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, type, value])
  @@index([tenantId, contactId])
  @@map("contact_identity")
}

model Conversation {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channelId String  @map("channel_id") @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status ConversationStatus @default(OPEN)

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// La ventana de 24 h de Meta. Fuera de ella sólo se pueden enviar
  /// plantillas aprobadas. La interfaz lee esto para bloquear el envío libre
  /// ANTES de que el agente escriba, no después del rechazo de la API.
  windowExpiresAt DateTime? @map("window_expires_at") @db.Timestamptz(6)

  /// Desnormalizados para pintar la lista de la bandeja sin un join por fila.
  lastMessageAt        DateTime?         @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview   String?           @map("last_message_preview") @db.VarChar(200)
  lastMessageDirection MessageDirection? @map("last_message_direction")
  unreadCount          Int               @default(0) @map("unread_count")

  /// Silenciar la respuesta automática de IA en esta conversación concreta.
  aiEnabled Boolean @default(true) @map("ai_enabled")

  snoozedUntil DateTime? @map("snoozed_until") @db.Timestamptz(6)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)

  messages  Message[]
  aiThreads AiThread[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([channelId, contactId])
  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, contactId])
  @@map("conversation")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
}

/// La tabla que más crece del sistema. Particionada por rango mensual sobre
/// `createdAt` en la migración.
model Message {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channelId      String       @map("channel_id") @db.Uuid
  channel        Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  direction MessageDirection
  type      MessageType      @default(TEXT)

  body String? @db.Text

  /// Id del mensaje en el proveedor (wamid de Meta). Único por canal: es la
  /// defensa contra los reintentos de webhook, que SÍ ocurren.
  externalId String? @map("external_id") @db.VarChar(160)

  status          MessageDeliveryStatus @default(QUEUED)
  statusUpdatedAt DateTime?             @map("status_updated_at") @db.Timestamptz(6)
  errorCode       String?               @map("error_code") @db.VarChar(40)
  errorMessage    String?               @map("error_message")

  /// Quién lo envió: un agente, la IA, una automatización o el contacto.
  senderUserId String?   @map("sender_user_id") @db.Uuid
  senderType   ActorType @default(USER) @map("sender_type")

  /// Nota interna: visible para el equipo, nunca enviada al contacto.
  isInternal Boolean @default(false) @map("is_internal")

  templateId     String?     @map("template_id") @db.Uuid
  template       WaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Variables con las que se rellenó la plantilla.
  templateParams Json?       @map("template_params") @db.JsonB

  /// Mensaje al que responde, si es una respuesta citada.
  replyToExternalId String? @map("reply_to_external_id") @db.VarChar(160)

  /// Carga cruda del proveedor, para depurar sin pedirle capturas al cliente.
  rawPayload Json? @map("raw_payload") @db.JsonB

  media MessageMedia[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([channelId, externalId], map: "message_channel_external_key")
  @@index([tenantId, conversationId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("message")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  TEMPLATE
  INTERACTIVE
  REACTION
  SYSTEM
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model MessageMedia {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  messageId String  @map("message_id") @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileId String? @map("file_id") @db.Uuid
  file   File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  /// Id del medio en Meta. Su URL de descarga caduca en minutos: por eso un
  /// trabajo aparte lo baja y lo sube a nuestro almacenamiento.
  externalMediaId String? @map("external_media_id") @db.VarChar(160)

  mimeType        String? @map("mime_type") @db.VarChar(120)
  filename        String? @db.VarChar(255)
  sizeBytes       Int?    @map("size_bytes")
  caption         String?
  /// Duración en segundos, para audio y vídeo.
  durationSeconds Int?    @map("duration_seconds")

  downloadedAt  DateTime? @map("downloaded_at") @db.Timestamptz(6)
  downloadError String?   @map("download_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, messageId])
  @@map("message_media")
}

/// Plantillas de WhatsApp. Meta las aprueba; nosotros reflejamos su estado.
model WaTemplate {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channelId String  @map("channel_id") @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  name     String @db.VarChar(120)
  language String @default("es") @db.VarChar(10)
  category String @default("UTILITY") @db.VarChar(30) // MARKETING | UTILITY | AUTHENTICATION

  status         TemplateStatus @default(DRAFT)
  externalId     String?        @map("external_id") @db.VarChar(120)
  rejectedReason String?        @map("rejected_reason")

  /// Componentes tal como los define la Graph API: header, body, footer, buttons.
  components Json     @db.JsonB
  /// Nombres de las variables detectadas en el cuerpo, en orden: {{1}}, {{2}}…
  variables  String[]

  messages Message[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([channelId, name, language])
  @@index([tenantId, status])
  @@map("wa_template")
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

/// Webhooks entrantes crudos. Se persisten ANTES de procesarlos y se
/// responde 200 de inmediato: si tardamos, Meta reintenta y duplicamos.
/// La unicidad de `eventId` es lo que hace idempotente el reproceso.
model WebhookEvent {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  provider  String  @db.VarChar(40) // "meta" | "stripe" | ...
  eventId   String  @map("event_id") @db.VarChar(200)
  eventType String? @map("event_type") @db.VarChar(80)

  /// Puede ser nulo: se resuelve al procesar, no al recibir.
  tenantId  String? @map("tenant_id") @db.Uuid
  channelId String? @map("channel_id") @db.Uuid

  payload   Json    @db.JsonB
  signature String?

  status      WebhookStatus @default(PENDING)
  attempts    Int           @default(0)
  lastError   String?       @map("last_error")
  processedAt DateTime?     @map("processed_at") @db.Timestamptz(6)

  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([tenantId, receivedAt(sort: Desc)])
  @@map("webhook_event")
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

