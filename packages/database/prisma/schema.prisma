  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, dashboardId, sortOrder])
  @@map("widget")
}

enum WidgetType {
  KPI
  LINE
  BAR
  PIE
  FUNNEL
  TABLE
  LIST
  GAUGE
}

/// Vista guardada de una tabla: filtros, columnas, orden. Es lo que convierte
