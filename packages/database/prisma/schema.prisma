/// Todo archivo subido. Una sola tabla para adjuntos, PDFs, avatares y
/// fuentes de IA: un solo sitio donde contar almacenamiento y purgar.
model File {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Clave en el bucket. Nombre reescrito: el original nunca llega al disco.
  storageKey String @unique @map("storage_key") @db.VarChar(400)
  bucket     String @default("nexo") @db.VarChar(60)

  originalName String  @map("original_name") @db.VarChar(255)
  /// Detectado por número mágico, no por extensión.
  mimeType     String  @map("mime_type") @db.VarChar(120)
  sizeBytes    Int     @map("size_bytes")
  checksum     String? @db.VarChar(64)

  purpose FilePurpose @default(ATTACHMENT)

  uploadedById String? @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  scanStatus ScanStatus @default(PENDING) @map("scan_status")
  scanResult String?    @map("scan_result")

  media     MessageMedia[]
  aiSources AiSource[]
  documents Document[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, purpose, createdAt(sort: Desc)])
  @@index([tenantId, deletedAt])
  @@map("file")
}

enum FilePurpose {
  ATTACHMENT
  AVATAR
  LOGO
  DOCUMENT_PDF
  AI_SOURCE
  IMPORT
  EXPORT
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
  ERROR
}

/// Webhooks que la empresa configura para recibir eventos de Nexo en sus
/// propios sistemas. Firmados con HMAC-SHA256 y reintentados hasta 24 h.
model OutboundWebhook {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name   String   @db.VarChar(80)
  url    String
  events String[] // "contact.created", "deal.won", ...

  /// Cifrado. Se muestra una sola vez al crearlo.
  secretEncrypted String @map("secret_encrypted")

  active Boolean @default(true)

  /// Estadísticas para que el usuario vea si su endpoint está respondiendo.
  lastDeliveryAt      DateTime? @map("last_delivery_at") @db.Timestamptz(6)
  lastStatusCode      Int?      @map("last_status_code")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  /// Desactivado automáticamente tras demasiados fallos seguidos.
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, active])
  @@map("outbound_webhook")
}
