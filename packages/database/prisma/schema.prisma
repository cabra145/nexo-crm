  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String @db.VarChar(120)
  /// Si es nulo, el panel es de la empresa; si tiene valor, es privado de ese usuario.
  ownerId String? @db.Uuid @map("owner_id")

  isDefault Boolean @default(false) @map("is_default")
  /// Plantilla de la que nació: "sales" | "support" | "executive".
  preset    String? @db.VarChar(40)

  /// Disposición de la cuadrícula: posiciones y tamaños de cada widget.
  layout Json @default("{}") @db.JsonB

  widgets Widget[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, ownerId])
  @@map("dashboard")
}

model Widget {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId    String    @db.Uuid @map("tenant_id")
  dashboardId String    @db.Uuid @map("dashboard_id")
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  type  WidgetType
  title String     @db.VarChar(120)

  /// Qué mide: métrica, dimensión, rango, filtros, comparación.
  /// Se traduce a SQL por un constructor con lista blanca de campos; el
  /// usuario nunca escribe SQL ni nombres de columna libres.
