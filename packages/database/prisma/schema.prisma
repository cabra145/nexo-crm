// ============================================================================
//  Nexo CRM · Esquema de datos
// ----------------------------------------------------------------------------
//  Convenciones que rigen TODO este archivo:
//
//  1. Toda tabla de negocio lleva `tenantId` y una política RLS en
//     migrations/*_rls/migration.sql. La columna sola no aísla nada: el
//     aislamiento real lo impone Postgres.
//  2. Las claves primarias son UUID v7 (ordenables por tiempo) generadas por
//     `uuid_generate_v7()`, creada en la migración inicial.
//  3. Todo índice sobre una tabla con ámbito de empresa empieza por `tenantId`.
//     Sin eso, Postgres recorre filas de otras empresas antes de descartarlas.
//  4. Borrado lógico (`deletedAt`) sólo donde el usuario puede arrepentirse.
//     Lo demás se borra de verdad, en cascada.
//  5. Los importes son Decimal(14,2) y nunca Float. El dinero no es binario.
// ============================================================================

generator client {
  provider        = "prisma-client-js" 
 previewFeatures = ["postgresqlExtensions", "relationJoins"]
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}
datasource db {
  provider   = "postgresql"
  // Rol `nexo_app`: lo usa la aplicación. Sin BYPASSRLS y sin permiso para
  // alterar el esquema.
  url        = env("DATABASE_URL")
  // Rol dueño: lo usa Prisma Migrate. Sin esto, las migraciones intentarían
  // crear tablas con `nexo_app`, que a propósito no puede hacerlo.
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, vector, btree_gin]
}

// ============================================================================
//  DOMINIO 1 · PLATAFORMA
//  Vive por encima de las empresas. Sin `tenantId`, sin RLS: son los datos
//  del negocio SaaS, no de sus clientes.
// ============================================================================

model Plan {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code        String  @unique // "free" | "starter" | "pro" | "business"
  name        String
  description String?

  priceMonthly Decimal @default(0) @db.Decimal(10, 2) @map("price_monthly")
  priceYearly  Decimal @default(0) @db.Decimal(10, 2) @map("price_yearly")
  currency     String  @default("USD") @db.Char(3)

  // Límites aplicados en caliente por el guard de cuotas.
  // -1 = ilimitado. Se leen desde caché de Redis, no de la BD, en cada petición.
  maxUsers          Int @default(3) @map("max_users")
  maxContacts       Int @default(1000) @map("max_contacts")
  maxChannels       Int @default(1) @map("max_channels")
  maxWorkflows      Int @default(3) @map("max_workflows")
  maxAiSources      Int @default(10) @map("max_ai_sources")
  maxStorageMb      Int @default(1024) @map("max_storage_mb")
  monthlyAiCredits  Int @default(0) @map("monthly_ai_credits")
  monthlyMessages   Int @default(1000) @map("monthly_messages")

  isPublic  Boolean @default(true) @map("is_public") // visible en la página de precios
  isDefault Boolean @default(false) @map("is_default") // asignado al registrarse
  trialDays Int     @default(14) @map("trial_days")
  sortOrder Int     @default(0) @map("sort_order")

  features      PlanFeature[]
  subscriptions Subscription[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  archivedAt DateTime? @db.Timestamptz(6) @map("archived_at")

  @@index([isPublic, sortOrder])
  @@map("plan")
}

/// Banderas de funcionalidad por plan. Separadas de los límites numéricos
/// porque se consultan distinto: "¿puede usar IA?" vs "¿cuántos contactos?".
model PlanFeature {
  id      String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  planId  String @db.Uuid @map("plan_id")
  plan    Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  key     String // "ai.rag" | "automation.visual" | "whatsapp" | "api.public" | "custom_roles"
  enabled Boolean @default(true)
  config  Json?   @db.JsonB

  @@unique([planId, key])
  @@map("plan_feature")
}

/// La empresa. Raíz de todo el aislamiento del sistema.
model Tenant {
  id   String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug String @unique @db.VarChar(63) // subdominio y segmento de URL: /w/acme
  name String @db.VarChar(160)

  status TenantStatus @default(TRIAL)

  // Identidad visual, usada en la app, los correos y los PDFs.
  logoUrl      String? @map("logo_url")
  brandColor   String? @db.VarChar(9) @map("brand_color")
  legalName    String? @db.VarChar(200) @map("legal_name")
  taxId        String? @db.VarChar(40) @map("tax_id")
  addressLine  String? @map("address_line")
  city         String? @db.VarChar(120)
  country      String? @db.Char(2)
  phone        String? @db.VarChar(32)
  website      String?

  timezone String @default("America/Guayaquil") @db.VarChar(64)
  locale   String @default("es") @db.VarChar(10)
  currency String @default("USD") @db.Char(3)

  /// Ajustes libres del espacio de trabajo. Se cachean en Redis y se
  /// invalidan por evento; nunca se leen dentro de un bucle.
  settings Json @default("{}") @db.JsonB

  suspendedAt     DateTime? @db.Timestamptz(6) @map("suspended_at")
  suspendedReason String? @map("suspended_reason")
  deletedAt       DateTime? @db.Timestamptz(6) @map("deleted_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  subscription   Subscription?
  memberships    Membership[]
  roles          Role[]
  usage          TenantUsage[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  contacts       Contact[]
  companies      Company[]
  tags           Tag[]
  customFields   CustomField[]
  notes          Note[]
  activities     Activity[]
  pipelines      Pipeline[]
  deals          Deal[]
  products       Product[]
  lostReasons    LostReason[]
  channels       Channel[]
  conversations  Conversation[]
  messages       Message[]
  waTemplates    WaTemplate[]
  aiSources      AiSource[]
  aiThreads      AiThread[]
  aiUsage        AiUsage[]
  aiSetting      AiSetting?
  workflows      Workflow[]
  documents      Document[]
  taxRates       TaxRate[]
  numberSequences NumberSequence[]
  docTemplates   DocTemplate[]
  tasks          Task[]
  events         Event[]
  dashboards     Dashboard[]
  savedViews     SavedView[]
  notifications  Notification[]
  files          File[]
  outboundHooks  OutboundWebhook[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenant")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Subscription {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @unique @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId String @db.Uuid @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id])

  status   SubscriptionStatus @default(TRIALING)
  interval PlanInterval       @default(MONTHLY)

  // Referencias a la pasarela. Nulas hasta la Fase 5: el modelo está
  // preparado pero ningún cobro está acoplado todavía.
  providerName           String? @db.VarChar(40) @map("provider_name")
  providerCustomerId     String? @db.VarChar(120) @map("provider_customer_id")
  providerSubscriptionId String? @unique @db.VarChar(120) @map("provider_subscription_id")

  currentPeriodStart DateTime  @default(now()) @db.Timestamptz(6) @map("current_period_start")
  currentPeriodEnd   DateTime  @db.Timestamptz(6) @map("current_period_end")
  trialEndsAt        DateTime? @db.Timestamptz(6) @map("trial_ends_at")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @db.Timestamptz(6) @map("canceled_at")

  /// Sobrescribe límites del plan para un cliente concreto (acuerdos a medida).
  /// Se fusiona por encima del plan al calcular cuotas.
  limitOverrides Json? @db.JsonB @map("limit_overrides")

  invoices SubscriptionInvoice[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([status, currentPeriodEnd])
  @@map("subscription")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

/// Facturas que la plataforma emite a sus empresas cliente.
/// Distinto de `Document`, que son las facturas que las empresas emiten a los suyos.
model SubscriptionInvoice {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  subscriptionId String       @db.Uuid @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  number   String   @unique @db.VarChar(40)
  amount   Decimal  @db.Decimal(12, 2)
  currency String   @default("USD") @db.Char(3)
  status   String   @default("open") @db.VarChar(20) // open | paid | void | uncollectible
  paidAt   DateTime? @db.Timestamptz(6) @map("paid_at")
  dueAt    DateTime? @db.Timestamptz(6) @map("due_at")
  pdfUrl   String? @map("pdf_url")

  providerInvoiceId String? @unique @db.VarChar(120) @map("provider_invoice_id")

  periodStart DateTime @db.Timestamptz(6) @map("period_start")
  periodEnd   DateTime @db.Timestamptz(6) @map("period_end")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([subscriptionId, createdAt])
  @@index([status, dueAt])
  @@map("subscription_invoice")
}

/// Consumo agregado por empresa y día. Alimenta los límites de plan y el
/// panel de plataforma sin tener que contar filas en tablas grandes.
model TenantUsage {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  day DateTime @db.Date

  activeUsers      Int     @default(0) @map("active_users")
  contactCount     Int     @default(0) @map("contact_count")
  messagesIn       Int     @default(0) @map("messages_in")
  messagesOut      Int     @default(0) @map("messages_out")
  aiTokensIn       Int     @default(0) @map("ai_tokens_in")
  aiTokensOut      Int     @default(0) @map("ai_tokens_out")
  aiCostUsd        Decimal @default(0) @db.Decimal(10, 4) @map("ai_cost_usd")
  workflowRuns     Int     @default(0) @map("workflow_runs")
  documentsIssued  Int     @default(0) @map("documents_issued")
  storageMb        Int     @default(0) @map("storage_mb")
  apiCalls         Int     @default(0) @map("api_calls")

  @@unique([tenantId, day])
  @@index([day])
  @@map("tenant_usage")
}

/// Operadores de la plataforma. Tabla aparte de `User` a propósito: un
/// superadmin no es un usuario con una bandera, es una entidad distinta con
/// otro ciclo de vida, otro login y 2FA obligatorio.
model PlatformAdmin {
  id           String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email        String  @unique @db.VarChar(255)
  passwordHash String @map("password_hash")
  name         String  @db.VarChar(120)

  totpSecret     String? @map("totp_secret") // cifrado AES-256-GCM en la capa de aplicación
  totpEnabled    Boolean @default(false) @map("totp_enabled")
  recoveryCodes  String[] @map("recovery_codes") // hashes, de un solo uso

  lastLoginAt DateTime? @db.Timestamptz(6) @map("last_login_at")
  lastLoginIp String?   @db.Inet @map("last_login_ip")
  disabledAt  DateTime? @db.Timestamptz(6) @map("disabled_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@map("platform_admin")
}

// ============================================================================
//  DOMINIO 2 · IDENTIDAD Y ACCESO
// ============================================================================

/// Una persona. Puede pertenecer a varias empresas: `User` no lleva `tenantId`.
/// La relación con la empresa vive en `Membership`.
model User {
  id           String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email        String  @unique @db.VarChar(255)
  passwordHash String? @map("password_hash")
  name         String  @db.VarChar(120)
  avatarUrl    String? @map("avatar_url")
  phone        String? @db.VarChar(32)
  locale       String  @default("es") @db.VarChar(10)
  timezone     String? @db.VarChar(64)

  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @db.Timestamptz(6) @map("email_verified_at")

  totpEnabled   Boolean  @default(false) @map("totp_enabled")
  recoveryCodes String[] @map("recovery_codes") // hashes Argon2 de un solo uso

  lastLoginAt DateTime? @db.Timestamptz(6) @map("last_login_at")
  lastLoginIp String?   @db.Inet @map("last_login_ip")

  /// Intentos fallidos consecutivos. El bloqueo real lo hace el limitador de
  /// tasa en Redis; esto es para mostrárselo al usuario y auditarlo.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @db.Timestamptz(6) @map("locked_until")

  /// Preferencias de interfaz: tema, densidad de tabla, columnas visibles.
  preferences Json @default("{}") @db.JsonB

  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")

  memberships   Membership[]
  refreshTokens RefreshToken[]
  totp          TotpSecret?
  emailTokens   EmailToken[]
  notifications Notification[]

  ownedContacts      Contact[]      @relation("ContactOwner")
  ownedDeals         Deal[]         @relation("DealOwner")
  assignedConvos     Conversation[] @relation("ConversationAssignee")
  assignedTasks      Task[]         @relation("TaskAssignee")
  createdTasks       Task[]         @relation("TaskCreator")
  authoredNotes      Note[]
  authoredActivities Activity[]
  organizedEvents    Event[]        @relation("EventOrganizer")
  uploadedFiles      File[]
  aiThreads          AiThread[]
  availability       Availability[]

  @@index([status])
  @@index([deletedAt])
  @@map("user")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

/// La pertenencia de un usuario a una empresa, con su rol.
/// Es la tabla que el guard de tenant consulta en CADA petición (cacheada).
model Membership {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @db.Uuid @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId String @db.Uuid @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  status MembershipStatus @default(INVITED)

  /// Equipo al que pertenece. Determina el alcance "su equipo" del rol MANAGER.
  teamName String? @db.VarChar(80) @map("team_name")

  invitedByUserId String?   @db.Uuid @map("invited_by_user_id")
  invitedAt       DateTime  @default(now()) @db.Timestamptz(6) @map("invited_at")
  acceptedAt      DateTime? @db.Timestamptz(6) @map("accepted_at")
  disabledAt      DateTime? @db.Timestamptz(6) @map("disabled_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@map("membership")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Rol dentro de una empresa. Los cinco del sistema se crean con cada empresa
/// (`isSystem = true`, no editables); los planes altos pueden crear más.
model Role {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key         SystemRole
  name        String     @db.VarChar(80)
  description String?
  isSystem    Boolean    @default(false) @map("is_system")

  memberships Membership[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("role")
}

enum SystemRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
  CUSTOM
}

/// Un permiso concedido a un rol. `permission` es la cadena granular
/// ("contact:read", "deal:delete", "billing:manage") y `scope` responde a
/// "¿sobre qué filas?" — la distinción entre un Manager y un Agente.
model RolePermission {
  id     String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  roleId String @db.Uuid @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission String          @db.VarChar(64)
  scope      PermissionScope @default(ALL)

  @@unique([roleId, permission])
  @@index([roleId])
  @@map("role_permission")
}

enum PermissionScope {
  ALL // toda la empresa
  TEAM // registros de su equipo
  OWN // sólo los que le pertenecen
}

/// Familia de tokens de refresco. La rotación con detección de reuso vive aquí:
/// si llega un token ya consumido, se revoca toda la familia.
model RefreshToken {
  id     String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 del token. El valor en claro sólo existe en la cookie del cliente.
  tokenHash String @unique @db.VarChar(64) @map("token_hash")

  /// Identificador de familia: todos los tokens nacidos de un mismo login.
  familyId String @db.Uuid @map("family_id")

  /// Empresa activa cuando se emitió. Cambiar de espacio emite un token nuevo.
  tenantId String? @db.Uuid @map("tenant_id")

  userAgent String? @map("user_agent")
  ip        String? @db.Inet

  expiresAt DateTime  @db.Timestamptz(6) @map("expires_at")
  usedAt    DateTime? @db.Timestamptz(6) @map("used_at")
  revokedAt DateTime? @db.Timestamptz(6) @map("revoked_at")
  revokedReason String? @db.VarChar(60) @map("revoked_reason") // "rotation" | "reuse_detected" | "logout" | "password_change"

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model TotpSecret {
  id     String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId String @unique @db.Uuid @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Cifrado con AES-256-GCM. La clave maestra vive fuera de la base de datos.
  secretEncrypted String @map("secret_encrypted")
  confirmedAt     DateTime? @db.Timestamptz(6) @map("confirmed_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@map("totp_secret")
}

/// Tokens de un solo uso: verificación de correo, recuperación de contraseña
/// e invitaciones. Una tabla en vez de tres porque el ciclo de vida es idéntico.
model EmailToken {
  id     String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String         @unique @db.VarChar(64) @map("token_hash")
  purpose   EmailTokenPurpose

  /// Contexto extra: para invitaciones, la empresa y el rol propuestos.
  payload Json? @db.JsonB

  expiresAt DateTime  @db.Timestamptz(6) @map("expires_at")
  usedAt    DateTime? @db.Timestamptz(6) @map("used_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_token")
}

enum EmailTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
  EMAIL_CHANGE
}

/// Claves de la API pública, por empresa.
model ApiKey {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(80)
  /// Prefijo visible para que el usuario identifique la clave sin revelarla.
  prefix    String  @unique @db.VarChar(16)
  keyHash   String  @unique @db.VarChar(64) @map("key_hash")
  scopes    String[]

  lastUsedAt DateTime? @db.Timestamptz(6) @map("last_used_at")
  expiresAt  DateTime? @db.Timestamptz(6) @map("expires_at")
  revokedAt  DateTime? @db.Timestamptz(6) @map("revoked_at")

  createdByUserId String? @db.Uuid @map("created_by_user_id")
  createdAt       DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, revokedAt])
  @@map("api_key")
}

/// Registro inmutable. Se escribe desde el worker vía cola para no penalizar
/// la petición del usuario. Particionado por mes en la migración.
model AuditLog {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorUserId  String?  @db.Uuid @map("actor_user_id")
  actorEmail   String?  @db.VarChar(255) @map("actor_email")
  actorType    ActorType @default(USER) @map("actor_type")

  action       AuditAction
  resourceType String      @db.VarChar(60) @map("resource_type")
  resourceId   String?     @db.Uuid @map("resource_id")
  resourceLabel String?    @db.VarChar(200) @map("resource_label")

  /// Diferencia de valores { campo: { antes, despues } }. Campos sensibles
  /// redactados por el serializador antes de llegar aquí.
  changes Json? @db.JsonB

  ip        String? @db.Inet
  userAgent String? @map("user_agent")
  traceId   String? @db.VarChar(40) @map("trace_id")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, actorUserId, createdAt(sort: Desc)])
  @@map("audit_log")
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
  AUTOMATION
  SUPPORT // suplantación con consentimiento
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  TWO_FACTOR_ENABLE
  TWO_FACTOR_DISABLE
  EXPORT
  IMPORT
  INVITE
  ROLE_CHANGE
  IMPERSONATE_START
  IMPERSONATE_END
  SETTINGS_CHANGE
  SEND
}

