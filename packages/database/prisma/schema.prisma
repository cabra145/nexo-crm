  @@index([tenantId, purpose, createdAt(sort: Desc)])
  @@index([tenantId, deletedAt])
  @@map("file")
}

enum FilePurpose {
  ATTACHMENT
  AVATAR
  LOGO
  DOCUMENT_PDF
  AI_SOURCE
  IMPORT
  EXPORT
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
  ERROR
}

/// Webhooks que la empresa configura para recibir eventos de Nexo en sus
/// propios sistemas. Firmados con HMAC-SHA256 y reintentados hasta 24 h.
model OutboundWebhook {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name   String   @db.VarChar(80)
  url    String
  events String[] // "contact.created", "deal.won", ...

  /// Cifrado. Se muestra una sola vez al crearlo.
  secretEncrypted String @map("secret_encrypted")

  active Boolean @default(true)

  /// Estadísticas para que el usuario vea si su endpoint está respondiendo.
  lastDeliveryAt     DateTime? @db.Timestamptz(6) @map("last_delivery_at")
  lastStatusCode     Int? @map("last_status_code")
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  /// Desactivado automáticamente tras demasiados fallos seguidos.
  disabledAt         DateTime? @db.Timestamptz(6) @map("disabled_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, active])
  @@map("outbound_webhook")
}
