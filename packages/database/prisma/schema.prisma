model Dashboard {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String  @db.VarChar(120)
  /// Si es nulo, el panel es de la empresa; si tiene valor, es privado de ese usuario.
  ownerId String? @map("owner_id") @db.Uuid

  isDefault Boolean @default(false) @map("is_default")
  /// Plantilla de la que nació: "sales" | "support" | "executive".
  preset    String? @db.VarChar(40)

  /// Disposición de la cuadrícula: posiciones y tamaños de cada widget.
  layout Json @default("{}") @db.JsonB

  widgets Widget[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, ownerId])
  @@map("dashboard")
}

model Widget {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  dashboardId String    @map("dashboard_id") @db.Uuid
