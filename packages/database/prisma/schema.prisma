model Pipeline {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(80)
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int     @default(0) @map("sort_order")

  stages PipelineStage[]
  deals  Deal[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  archivedAt DateTime? @db.Timestamptz(6) @map("archived_at")

  @@unique([tenantId, name])
  @@index([tenantId, archivedAt])
  @@map("pipeline")
}

/// Las siete etapas por defecto (Nuevo → Ganado/Perdido) se crean con cada
/// empresa, pero son editables: cada negocio tiene su propio embudo.
model PipelineStage {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  pipelineId String   @db.Uuid @map("pipeline_id")
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name  String    @db.VarChar(60)
  type  StageType @default(OPEN)
  color String    @default("#6B7280") @db.VarChar(9)

  /// Probabilidad por defecto al entrar en la etapa. La previsión ponderada
  /// usa la del trato, no ésta; ésta sólo la precarga.
  probability Int @default(0)

  position Float @default(1000)

  /// Días tras los cuales un trato en esta etapa se marca como estancado.
  rottingDays Int? @map("rotting_days")

  deals   Deal[]
  history DealStageHistory[]

  @@unique([pipelineId, name])
  @@index([tenantId, pipelineId, position])
  @@map("pipeline_stage")
}

enum StageType {
  OPEN
  WON
  LOST
}

model Deal {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title String @db.VarChar(200)

  pipelineId String   @db.Uuid @map("pipeline_id")
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stageId    String   @db.Uuid @map("stage_id")
  stage      PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  contactId String?  @db.Uuid @map("contact_id")
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId String?  @db.Uuid @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  ownerId String? @db.Uuid @map("owner_id")
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  value       Decimal @default(0) @db.Decimal(14, 2)
  currency    String  @default("USD") @db.Char(3)
  probability Int     @default(0)

  status         DealStatus @default(OPEN)
  expectedCloseAt DateTime? @db.Date @map("expected_close_at")
  closedAt        DateTime? @db.Timestamptz(6) @map("closed_at")

  lostReasonId   String?     @db.Uuid @map("lost_reason_id")
  lostReason     LostReason? @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  lostReasonNote String? @map("lost_reason_note")

  /// Orden fraccional dentro de la columna del Kanban. Mover una tarjeta
  /// escribe UNA fila: se toma el punto medio entre sus dos vecinas y sólo se
  /// reequilibra la columna cuando el hueco se agota.
  position Float @default(1000)

  source String? @db.VarChar(80)
  custom Json    @default("{}") @db.JsonB

  /// Desnormalizado desde `deal_item` para poder ordenar y sumar sin join.
  itemsTotal Decimal @default(0) @db.Decimal(14, 2) @map("items_total")

  stageEnteredAt DateTime @default(now()) @db.Timestamptz(6) @map("stage_entered_at")
  lastActivityAt DateTime? @db.Timestamptz(6) @map("last_activity_at")

  items        DealItem[]
  stageHistory DealStageHistory[]
  notes        Note[]
  activities   Activity[]
  tasks        Task[]
  documents    Document[]
  fieldValues  CustomFieldValue[]
  events       Event[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")

  @@index([tenantId, pipelineId, stageId, position])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, status, expectedCloseAt])
  @@index([tenantId, contactId])
  @@index([tenantId, deletedAt])
  @@map("deal")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

/// Cada movimiento entre etapas, con su duración. Sin esta tabla escribiéndose
/// desde el primer día, la métrica "tiempo medio en negociación" no existe
/// jamás — no se puede reconstruir a posteriori.
model DealStageHistory {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  dealId   String @db.Uuid @map("deal_id")
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  stageId     String        @db.Uuid @map("stage_id")
  stage       PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  fromStageId String?       @db.Uuid @map("from_stage_id")

  movedByUserId String? @db.Uuid @map("moved_by_user_id")
  movedByType   ActorType @default(USER) @map("moved_by_type")

  enteredAt DateTime  @default(now()) @db.Timestamptz(6) @map("entered_at")
  exitedAt  DateTime? @db.Timestamptz(6) @map("exited_at")
  /// Calculado al salir. Redundante con las fechas, pero evita aritmética de
  /// intervalos en cada consulta del panel comercial.
  durationSeconds Int? @map("duration_seconds")

  @@index([tenantId, dealId, enteredAt])
  @@index([tenantId, stageId, enteredAt])
  @@map("deal_stage_history")
}

model Product {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sku         String? @db.VarChar(60)
  name        String  @db.VarChar(200)
  description String?

  unitPrice Decimal @default(0) @db.Decimal(14, 2) @map("unit_price")
  currency  String  @default("USD") @db.Char(3)
  unit      String  @default("unidad") @db.VarChar(30)

  taxRateId String?  @db.Uuid @map("tax_rate_id")
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  dealItems     DealItem[]
  documentItems DocumentItem[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, sku])
  @@index([tenantId, active, name])
  @@map("product")
}

model DealItem {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  dealId   String @db.Uuid @map("deal_id")
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  productId String?  @db.Uuid @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Copia del nombre y precio en el momento de añadirlo: si el producto
  /// cambia de precio mañana, el trato de ayer no se reescribe solo.
  name      String  @db.VarChar(200)
  quantity  Decimal @default(1) @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(14, 2) @map("unit_price")
  discount  Decimal @default(0) @db.Decimal(5, 2) // porcentaje
  total     Decimal @db.Decimal(14, 2)

  sortOrder Int @default(0) @map("sort_order")

  @@index([tenantId, dealId])
  @@map("deal_item")
}

model LostReason {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(120)
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  deals Deal[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("lost_reason")
}

// ============================================================================
//  DOMINIO 5 · CONVERSACIONES
//  Modelado genérico por canal desde el principio: añadir Instagram o correo
//  en el roadmap es integración, no migración.
// ============================================================================

model Channel {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type   ChannelType
  name   String        @db.VarChar(80)
  status ChannelStatus @default(PENDING)

  /// Identificador del canal en el proveedor. Para WhatsApp Cloud es el
  /// phone_number_id de Meta: es lo que permite resolver a qué empresa
  /// pertenece un webhook entrante.
  externalId String? @db.VarChar(120) @map("external_id")
  /// Número en E.164, para mostrar.
  displayId  String? @db.VarChar(40) @map("display_id")

  /// Credenciales cifradas con AES-256-GCM. NUNCA vuelven al cliente, ni
  /// enmascaradas desde la BD: la interfaz muestra sólo los últimos 4.
  credentialsEncrypted String? @map("credentials_encrypted")
  /// Secreto de verificación del webhook, también cifrado.
  webhookSecretEncrypted String? @map("webhook_secret_encrypted")

  config Json @default("{}") @db.JsonB

  lastErrorAt      DateTime? @db.Timestamptz(6) @map("last_error_at")
  lastErrorMessage String? @map("last_error_message")
  connectedAt      DateTime? @db.Timestamptz(6) @map("connected_at")

  conversations Conversation[]
  templates     WaTemplate[]
  messages      Message[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([type, externalId], map: "channel_provider_identity_key")
  @@index([tenantId, type, status])
  @@map("channel")
}

enum ChannelType {
  WHATSAPP_CLOUD
  EMAIL
  SMS
  INSTAGRAM
  MESSENGER
  WEBCHAT
}

enum ChannelStatus {
  PENDING
  CONNECTED
  ERROR
  DISABLED
}

/// Identidad de un contacto en un canal concreto (su número de WhatsApp, su
/// usuario de Instagram). Permite que un contacto tenga varias y que un
/// mensaje entrante encuentre a su persona.
model ContactIdentity {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")

  contactId String  @db.Uuid @map("contact_id")
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  type ChannelType
  /// Para WhatsApp: el wa_id que devuelve Meta, en E.164 sin el '+'.
  value String @db.VarChar(120)

  verified Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, type, value])
  @@index([tenantId, contactId])
  @@map("contact_identity")
}

model Conversation {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channelId String  @db.Uuid @map("channel_id")
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  contactId String  @db.Uuid @map("contact_id")
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status ConversationStatus @default(OPEN)

  assigneeId String? @db.Uuid @map("assignee_id")
  assignee   User?   @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// La ventana de 24 h de Meta. Fuera de ella sólo se pueden enviar
  /// plantillas aprobadas. La interfaz lee esto para bloquear el envío libre
  /// ANTES de que el agente escriba, no después del rechazo de la API.
  windowExpiresAt DateTime? @db.Timestamptz(6) @map("window_expires_at")

  /// Desnormalizados para pintar la lista de la bandeja sin un join por fila.
  lastMessageAt      DateTime? @db.Timestamptz(6) @map("last_message_at")
  lastMessagePreview String?   @db.VarChar(200) @map("last_message_preview")
  lastMessageDirection MessageDirection? @map("last_message_direction")
  unreadCount        Int       @default(0) @map("unread_count")

  /// Silenciar la respuesta automática de IA en esta conversación concreta.
  aiEnabled Boolean @default(true) @map("ai_enabled")

  snoozedUntil DateTime? @db.Timestamptz(6) @map("snoozed_until")
  resolvedAt   DateTime? @db.Timestamptz(6) @map("resolved_at")

  messages  Message[]
  aiThreads AiThread[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([channelId, contactId])
  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, contactId])
  @@map("conversation")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
}

/// La tabla que más crece del sistema. Particionada por rango mensual sobre
/// `createdAt` en la migración.
model Message {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  conversationId String       @db.Uuid @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channelId      String       @db.Uuid @map("channel_id")
  channel        Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  direction MessageDirection
  type      MessageType      @default(TEXT)

  body String? @db.Text

  /// Id del mensaje en el proveedor (wamid de Meta). Único por canal: es la
  /// defensa contra los reintentos de webhook, que SÍ ocurren.
  externalId String? @db.VarChar(160) @map("external_id")

  status MessageDeliveryStatus @default(QUEUED)
  statusUpdatedAt DateTime?    @db.Timestamptz(6) @map("status_updated_at")
  errorCode    String?         @db.VarChar(40) @map("error_code")
  errorMessage String? @map("error_message")

  /// Quién lo envió: un agente, la IA, una automatización o el contacto.
  senderUserId String?   @db.Uuid @map("sender_user_id")
  senderType   ActorType @default(USER) @map("sender_type")

  /// Nota interna: visible para el equipo, nunca enviada al contacto.
  isInternal Boolean @default(false) @map("is_internal")

  templateId String?     @db.Uuid @map("template_id")
  template   WaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Variables con las que se rellenó la plantilla.
  templateParams Json? @db.JsonB @map("template_params")

  /// Mensaje al que responde, si es una respuesta citada.
  replyToExternalId String? @db.VarChar(160) @map("reply_to_external_id")

  /// Carga cruda del proveedor, para depurar sin pedirle capturas al cliente.
  rawPayload Json? @db.JsonB @map("raw_payload")

  media MessageMedia[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([channelId, externalId], map: "message_channel_external_key")
  @@index([tenantId, conversationId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("message")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  TEMPLATE
  INTERACTIVE
  REACTION
  SYSTEM
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model MessageMedia {
  id       String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String  @db.Uuid @map("tenant_id")
  messageId String @db.Uuid @map("message_id")
  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileId String? @db.Uuid @map("file_id")
  file   File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  /// Id del medio en Meta. Su URL de descarga caduca en minutos: por eso un
  /// trabajo aparte lo baja y lo sube a nuestro almacenamiento.
  externalMediaId String? @db.VarChar(160) @map("external_media_id")

  mimeType String? @db.VarChar(120) @map("mime_type")
  filename String? @db.VarChar(255)
  sizeBytes Int? @map("size_bytes")
  caption  String?
  /// Duración en segundos, para audio y vídeo.
  durationSeconds Int? @map("duration_seconds")

  downloadedAt DateTime? @db.Timestamptz(6) @map("downloaded_at")
  downloadError String? @map("download_error")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, messageId])
  @@map("message_media")
}

/// Plantillas de WhatsApp. Meta las aprueba; nosotros reflejamos su estado.
model WaTemplate {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channelId String  @db.Uuid @map("channel_id")
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  name     String @db.VarChar(120)
  language String @default("es") @db.VarChar(10)
  category String @default("UTILITY") @db.VarChar(30) // MARKETING | UTILITY | AUTHENTICATION

  status TemplateStatus @default(DRAFT)
  externalId String?    @db.VarChar(120) @map("external_id")
  rejectedReason String? @map("rejected_reason")

  /// Componentes tal como los define la Graph API: header, body, footer, buttons.
  components Json @db.JsonB
  /// Nombres de las variables detectadas en el cuerpo, en orden: {{1}}, {{2}}…
  variables  String[]

  messages Message[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([channelId, name, language])
  @@index([tenantId, status])
  @@map("wa_template")
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

/// Webhooks entrantes crudos. Se persisten ANTES de procesarlos y se
/// responde 200 de inmediato: si tardamos, Meta reintenta y duplicamos.
/// La unicidad de `eventId` es lo que hace idempotente el reproceso.
model WebhookEvent {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  provider String @db.VarChar(40) // "meta" | "stripe" | ...
  eventId  String @db.VarChar(200) @map("event_id")
  eventType String? @db.VarChar(80) @map("event_type")

  /// Puede ser nulo: se resuelve al procesar, no al recibir.
  tenantId  String? @db.Uuid @map("tenant_id")
  channelId String? @db.Uuid @map("channel_id")

  payload   Json    @db.JsonB
  signature String?

  status       WebhookStatus @default(PENDING)
  attempts     Int           @default(0)
  lastError    String? @map("last_error")
  processedAt  DateTime?     @db.Timestamptz(6) @map("processed_at")

  receivedAt DateTime @default(now()) @db.Timestamptz(6) @map("received_at")

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([tenantId, receivedAt(sort: Desc)])
  @@map("webhook_event")
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

// ============================================================================
//  DOMINIO 6 · INTELIGENCIA ARTIFICIAL
// ============================================================================

model AiSource {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type   AiSourceType
  title  String       @db.VarChar(255)
  status AiSourceStatus @default(UPLOADED)

  fileId String? @db.Uuid @map("file_id")
  file   File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  url    String?

  /// Texto extraído completo. Se conserva para poder reindexar con otro
  /// tamaño de trozo sin volver a parsear el PDF.
  extractedText String? @db.Text @map("extracted_text")

  chunkCount Int @default(0) @map("chunk_count")
  tokenCount Int @default(0) @map("token_count")

  errorMessage String? @map("error_message")
  indexedAt    DateTime? @db.Timestamptz(6) @map("indexed_at")

  uploadedByUserId String? @db.Uuid @map("uploaded_by_user_id")

  chunks AiChunk[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")

  @@index([tenantId, status])
  @@index([tenantId, deletedAt, createdAt(sort: Desc)])
  @@map("ai_source")
}

enum AiSourceType {
  PDF
  DOCX
  TXT
  MARKDOWN
  URL
  MANUAL
}

enum AiSourceStatus {
  UPLOADED
  PROCESSING
  INDEXED
  ERROR
}

/// Un trozo indexado con su vector. El `tenantId` NO es decorativo: la
/// búsqueda vectorial filtra por él y la política RLS lo respalda. Es el
/// motivo de tener los embeddings en Postgres y no en una base aparte.
model AiChunk {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")

  sourceId String   @db.Uuid @map("source_id")
  source   AiSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// Posición dentro del documento, para citar "página 4" y ordenar el contexto.
  chunkIndex Int @map("chunk_index")
  content    String @db.Text
  tokens     Int    @default(0)

  /// Metadatos de cita: página, sección, encabezado.
  metadata Json? @db.JsonB

  /// text-embedding-3-small → 1536 dimensiones. Índice HNSW en la migración.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([sourceId, chunkIndex])
  @@index([tenantId, sourceId])
  @@map("ai_chunk")
}

model AiThread {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title String? @db.VarChar(200)

  /// Un hilo puede nacer del asistente general o estar anclado a una
  /// conversación de WhatsApp (resumen, respuesta sugerida).
  conversationId String?       @db.Uuid @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  purpose AiPurpose @default(CHAT)

  messages AiMessage[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, userId, updatedAt(sort: Desc)])
  @@index([tenantId, conversationId])
  @@map("ai_thread")
}

enum AiPurpose {
  CHAT
  REPLY_SUGGESTION
  AUTO_REPLY
  SUMMARY
  ANALYSIS
  NEXT_STEP
  DRAFT
}

model AiMessage {
  id       String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String   @db.Uuid @map("tenant_id")
  threadId String   @db.Uuid @map("thread_id")
  thread   AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  role    AiRole
  content String @db.Text

  /// Trozos usados como contexto. Es lo que permite mostrar "según el
  /// documento X, página 4" y lo que hace auditable la respuesta.
  citations Json? @db.JsonB

  model       String? @db.VarChar(60)
  tokensIn    Int     @default(0) @map("tokens_in")
  tokensOut   Int     @default(0) @map("tokens_out")
  latencyMs   Int? @map("latency_ms")
  finishReason String? @db.VarChar(30) @map("finish_reason")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, threadId, createdAt])
  @@map("ai_message")
}

enum AiRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

/// Consumo de IA por empresa. La plataforma paga primero y cobra después:
/// sin esta tabla no hay forma de poner un techo ni de repercutir el coste.
model AiUsage {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  purpose AiPurpose
  model   String    @db.VarChar(60)

  tokensIn  Int     @default(0) @map("tokens_in")
  tokensOut Int     @default(0) @map("tokens_out")
  costUsd   Decimal @default(0) @db.Decimal(10, 6) @map("cost_usd")

  userId String? @db.Uuid @map("user_id")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, purpose, createdAt])
  @@map("ai_usage")
}

model AiSetting {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @unique @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  /// Instrucciones de la empresa: tono, nombre del asistente, qué no decir.
  /// Se inyectan en el prompt de sistema por encima de las reglas base, que
  /// no son sobrescribibles por el cliente.
  systemPrompt String? @db.Text @map("system_prompt")
  assistantName String @default("Asistente") @db.VarChar(60) @map("assistant_name")
  tone         String  @default("profesional") @db.VarChar(40)

  /// Responder solo, o sugerir y que el agente decida.
  autoReply         Boolean @default(false) @map("auto_reply")
  /// No responder sola si hay un humano asignado a la conversación.
  autoReplySkipAssigned Boolean @default(true) @map("auto_reply_skip_assigned")
  /// Horario fuera del cual sí responde sola (JSON con franjas por día).
  autoReplySchedule Json? @db.JsonB @map("auto_reply_schedule")

  chatModel      String @default("gpt-4o-mini") @db.VarChar(60) @map("chat_model")
  embeddingModel String @default("text-embedding-3-small") @db.VarChar(60) @map("embedding_model")
  temperature    Decimal @default(0.3) @db.Decimal(3, 2)
  maxContextChunks Int   @default(6) @map("max_context_chunks")

  /// Techo mensual en dólares. Al alcanzarlo se corta, no se factura de más.
  monthlyBudgetUsd Decimal @default(0) @db.Decimal(10, 2) @map("monthly_budget_usd")

  /// Si la recuperación no alcanza este umbral de similitud, la IA no
  /// responde: deriva a un humano. Es la defensa contra la invención.
  minSimilarity Decimal @default(0.25) @db.Decimal(4, 3) @map("min_similarity")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@map("ai_setting")
}

// ============================================================================
//  DOMINIO 7 · AUTOMATIZACIONES
// ============================================================================

model Workflow {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String         @db.VarChar(120)
  description String?
  status      WorkflowStatus @default(DRAFT)

  /// Evento del bus que lo despierta: "contact.created", "deal.stage_changed",
  /// "whatsapp.message.received", "schedule.cron"…
  triggerType  String @db.VarChar(60) @map("trigger_type")
  /// Filtro del disparador: qué etapa, qué etiqueta, qué cron.
  triggerConfig Json  @default("{}") @db.JsonB @map("trigger_config")

  /// Versión publicada actualmente en ejecución.
  activeVersionId String? @unique @db.Uuid @map("active_version_id")

  /// Impide reinscribir al mismo contacto mientras ya está dentro del flujo.
  allowReenrollment Boolean @default(false) @map("allow_reenrollment")

  totalRuns   Int @default(0) @map("total_runs")
  failedRuns  Int @default(0) @map("failed_runs")

  createdByUserId String? @db.Uuid @map("created_by_user_id")

  versions    WorkflowVersion[]
  runs        WorkflowRun[]
  enrollments WorkflowEnrollment[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  archivedAt DateTime? @db.Timestamptz(6) @map("archived_at")

  @@index([tenantId, status])
  @@index([tenantId, triggerType, status])
  @@map("workflow")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// El grafo se versiona. Una ejecución en curso sigue usando la versión con
/// la que empezó: editar el flujo no rompe lo que ya está corriendo.
model WorkflowVersion {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  workflowId String   @db.Uuid @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  version Int

  /// Nodos y aristas del lienzo. Un solo jsonb porque el grafo se lee y se
  /// escribe entero: partirlo en dos tablas sólo añadiría joins.
  /// Validado contra un esquema zod antes de publicarse.
  graph Json @db.JsonB

  publishedAt     DateTime? @db.Timestamptz(6) @map("published_at")
  publishedByUserId String? @db.Uuid @map("published_by_user_id")

  runs WorkflowRun[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([workflowId, version])
  @@index([tenantId, workflowId])
  @@map("workflow_version")
}

model WorkflowRun {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  workflowId String   @db.Uuid @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionId  String   @db.Uuid @map("version_id")
  version    WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  status RunStatus @default(PENDING)

  /// Qué disparó esta ejecución.
  triggerEvent String  @db.VarChar(60) @map("trigger_event")
  subjectType  String? @db.VarChar(40) @map("subject_type")
  subjectId    String? @db.Uuid @map("subject_id")

  /// Variables acumuladas: salida de cada nodo disponible para los siguientes.
  context Json @default("{}") @db.JsonB

  currentNodeId String? @db.VarChar(60) @map("current_node_id")
  /// Cuándo despertar un nodo de espera. El programador lo consulta; una
  /// espera de 3 días no ocupa ningún proceso mientras tanto.
  resumeAt      DateTime? @db.Timestamptz(6) @map("resume_at")

  errorMessage String? @map("error_message")
  errorNodeId  String? @db.VarChar(60) @map("error_node_id")

  startedAt   DateTime  @default(now()) @db.Timestamptz(6) @map("started_at")
  completedAt DateTime? @db.Timestamptz(6) @map("completed_at")

  steps WorkflowRunStep[]

  @@index([tenantId, workflowId, startedAt(sort: Desc)])
  @@index([status, resumeAt])
  @@index([tenantId, subjectType, subjectId])
  @@map("workflow_run")
}

enum RunStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

/// Un paso ejecutado. Persistir cada paso es lo que hace el motor reanudable
/// tras un reinicio y lo que permite responder "¿por qué este flujo no hizo
/// lo que esperaba?" — que es la diferencia entre una función usable y una
/// que se abandona.
model WorkflowRunStep {
  id       String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String      @db.Uuid @map("tenant_id")
  runId    String      @db.Uuid @map("run_id")
  run      WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  nodeId   String     @db.VarChar(60) @map("node_id")
  nodeType String     @db.VarChar(60) @map("node_type")
  status   StepStatus @default(PENDING)

  input  Json? @db.JsonB
  output Json? @db.JsonB

  /// Para nodos de condición: qué rama se tomó y por qué.
  branchTaken String? @db.VarChar(60) @map("branch_taken")
  skipReason  String? @map("skip_reason")

  errorMessage String? @map("error_message")
  attempts     Int @default(0)

  startedAt   DateTime  @default(now()) @db.Timestamptz(6) @map("started_at")
  completedAt DateTime? @db.Timestamptz(6) @map("completed_at")
  durationMs  Int? @map("duration_ms")

  @@index([tenantId, runId, startedAt])
  @@map("workflow_run_step")
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

/// Registro de qué contacto entró en qué flujo y cuándo. Hace cumplir
/// `allowReenrollment` sin escanear las ejecuciones.
model WorkflowEnrollment {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  workflowId String   @db.Uuid @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  contactId String  @db.Uuid @map("contact_id")
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  runId String? @db.Uuid @map("run_id")

  enrolledAt DateTime  @default(now()) @db.Timestamptz(6) @map("enrolled_at")
  exitedAt   DateTime? @db.Timestamptz(6) @map("exited_at")
  exitReason String?   @db.VarChar(60) @map("exit_reason")

  @@index([tenantId, workflowId, contactId])
  @@index([tenantId, contactId])
  @@map("workflow_enrollment")
}

// ============================================================================
//  DOMINIO 8 · DOCUMENTOS COMERCIALES
//  Cotizaciones, proformas y facturas que las empresas emiten a SUS clientes.
//  Documento interno + PDF; sin firma fiscal (ver roadmap).
// ============================================================================

model Document {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind   DocumentKind
  /// Número visible al cliente: FAC-2026-00041. Generado con bloqueo de fila
  /// en `number_sequence` para que dos emisiones simultáneas nunca lo repitan.
  number String       @db.VarChar(40)
  status DocumentStatus @default(DRAFT)

  contactId String?  @db.Uuid @map("contact_id")
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId String?  @db.Uuid @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId    String?  @db.Uuid @map("deal_id")
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  /// Datos del cliente CONGELADOS al emitir. Si el contacto cambia de
  /// dirección mañana, la factura de ayer no se reescribe sola.
  billToName    String  @db.VarChar(200) @map("bill_to_name")
  billToTaxId   String? @db.VarChar(40) @map("bill_to_tax_id")
  billToEmail   String? @db.VarChar(255) @map("bill_to_email")
  billToAddress String? @map("bill_to_address")
  billToCity    String? @db.VarChar(120) @map("bill_to_city")
  billToCountry String? @db.Char(2) @map("bill_to_country")

  issueDate DateTime  @default(now()) @db.Date @map("issue_date")
  dueDate   DateTime? @db.Date @map("due_date")
  validUntil DateTime? @db.Date @map("valid_until") // para cotizaciones

  currency     String  @default("USD") @db.Char(3)
  /// Tipo de cambio a la moneda de la empresa en el momento de emitir.
  exchangeRate Decimal @default(1) @db.Decimal(12, 6) @map("exchange_rate")

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2) @map("discount_amount")
  taxAmount      Decimal @default(0) @db.Decimal(14, 2) @map("tax_amount")
  total          Decimal @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal @default(0) @db.Decimal(14, 2) @map("paid_amount")

  notes String? @db.Text
  terms String? @db.Text

  templateId String?      @db.Uuid @map("template_id")
  template   DocTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  pdfFileId String? @db.Uuid @map("pdf_file_id")
  pdfFile   File?   @relation(fields: [pdfFileId], references: [id], onDelete: SetNull)

  sentAt     DateTime? @db.Timestamptz(6) @map("sent_at")
  viewedAt   DateTime? @db.Timestamptz(6) @map("viewed_at")
  acceptedAt DateTime? @db.Timestamptz(6) @map("accepted_at")
  paidAt     DateTime? @db.Timestamptz(6) @map("paid_at")
  voidedAt   DateTime? @db.Timestamptz(6) @map("voided_at")

  /// Documento del que nace (cotización → factura).
  convertedFromId String? @db.Uuid @map("converted_from_id")

  createdByUserId String? @db.Uuid @map("created_by_user_id")

  items    DocumentItem[]
  payments Payment[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, kind, number])
  @@index([tenantId, kind, status, issueDate(sort: Desc)])
  @@index([tenantId, contactId])
  @@index([tenantId, dealId])
  @@index([tenantId, status, dueDate])
  @@map("document")
}

enum DocumentKind {
  QUOTE
  PROFORMA
  INVOICE
  CREDIT_NOTE
}

enum DocumentStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model DocumentItem {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  documentId String   @db.Uuid @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  productId String?  @db.Uuid @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name        String  @db.VarChar(200)
  description String?
  quantity    Decimal @db.Decimal(12, 3)
  unit        String  @default("unidad") @db.VarChar(30)
  unitPrice   Decimal @db.Decimal(14, 2) @map("unit_price")

  discountPercent Decimal @default(0) @db.Decimal(5, 2) @map("discount_percent")

  taxRateId   String?  @db.Uuid @map("tax_rate_id")
  taxRate     TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  /// Porcentaje congelado al emitir: si el IVA sube, la factura vieja no cambia.
  taxPercent  Decimal  @default(0) @db.Decimal(5, 2) @map("tax_percent")
  taxAmount   Decimal  @default(0) @db.Decimal(14, 2) @map("tax_amount")

  subtotal Decimal @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  sortOrder Int @default(0) @map("sort_order")

  @@index([tenantId, documentId, sortOrder])
  @@map("document_item")
}

model Payment {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  documentId String   @db.Uuid @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  amount   Decimal       @db.Decimal(14, 2)
  currency String        @default("USD") @db.Char(3)
  method   PaymentMethod @default(TRANSFER)

  reference String?  @db.VarChar(120)
  notes     String?
  paidAt    DateTime @default(now()) @db.Timestamptz(6) @map("paid_at")

  recordedByUserId String? @db.Uuid @map("recorded_by_user_id")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, documentId])
  @@index([tenantId, paidAt(sort: Desc)])
  @@map("payment")
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CHECK
  CRYPTO
  OTHER
}

model TaxRate {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(60) // "IVA 15%"
  percent   Decimal @db.Decimal(5, 2)
  isDefault Boolean @default(false) @map("is_default")
  active    Boolean @default(true)

  products      Product[]
  documentItems DocumentItem[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("tax_rate")
}

/// Contador por serie y tipo de documento. El servicio lo lee con
/// SELECT ... FOR UPDATE dentro de la transacción de emisión: es la única
/// forma de que dos facturas simultáneas no compartan número.
model NumberSequence {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind   DocumentKind
  /// Serie/establecimiento. "001" por defecto.
  series String       @default("001") @db.VarChar(10)
  year   Int

  prefix  String @default("") @db.VarChar(20)
  padding Int    @default(5)
  current Int    @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, kind, series, year])
  @@map("number_sequence")
}

model DocTemplate {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String       @db.VarChar(80)
  kind      DocumentKind
  isDefault Boolean      @default(false) @map("is_default")

  /// Colores, logo, pie de página, columnas visibles. La plantilla React del
  /// PDF lee esto; no hay HTML libre del usuario (superficie de XSS).
  design Json @default("{}") @db.JsonB

  headerNote String? @db.Text @map("header_note")
  footerNote String? @db.Text @map("footer_note")

  documents Document[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, kind, name])
  @@map("doc_template")
}

