enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Event {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(200)
  description String? @db.Text
  location    String? @db.VarChar(255)
  meetingUrl  String? @map("meeting_url")

  type EventType @default(MEETING)

  /// Siempre en UTC. La zona en la que se creó se guarda aparte para poder
  /// mostrar "10:00 hora de Quito" aunque el que mira esté en Madrid.
  startsAt DateTime @db.Timestamptz(6) @map("starts_at")
  endsAt   DateTime @db.Timestamptz(6) @map("ends_at")
  timezone String   @default("America/Guayaquil") @db.VarChar(64)
  allDay   Boolean  @default(false) @map("all_day")

  /// Regla de recurrencia RFC 5545 (RRULE). Las instancias no se materializan:
  /// se expanden al consultar un rango, y las excepciones viven en
  /// `recurrenceExceptions` para que editar un día no corrompa la serie.
  recurrenceRule       String?  @db.VarChar(255) @map("recurrence_rule")
  recurrenceExceptions DateTime[] @db.Timestamptz(6) @map("recurrence_exceptions")
  /// Para una instancia modificada de una serie.
  recurringEventId     String?  @db.Uuid @map("recurring_event_id")

  organizerId String? @db.Uuid @map("organizer_id")
  organizer   User?   @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)

  contactId String?  @db.Uuid @map("contact_id")
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId    String?  @db.Uuid @map("deal_id")
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  status EventStatus @default(CONFIRMED)

  attendees EventAttendee[]
  reminders Reminder[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")

  @@index([tenantId, startsAt])
  @@index([tenantId, organizerId, startsAt])
  @@index([tenantId, contactId])
  @@map("event")
}

enum EventType {
  MEETING
  CALL
  FOLLOW_UP
  DEMO
  OTHER
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

model EventAttendee {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  eventId  String @db.Uuid @map("event_id")
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Puede ser un usuario del equipo o un invitado externo por correo.
  userId    String? @db.Uuid @map("user_id")
  contactId String? @db.Uuid @map("contact_id")
  email     String? @db.VarChar(255)
  name      String? @db.VarChar(120)

  response AttendeeResponse @default(NEEDS_ACTION)
  isOrganizer Boolean       @default(false) @map("is_organizer")

  @@unique([eventId, email])
  @@index([tenantId, eventId])
  @@map("event_attendee")
}

enum AttendeeResponse {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

model Reminder {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")

  taskId  String? @db.Uuid @map("task_id")
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  eventId String? @db.Uuid @map("event_id")
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String @db.Uuid @map("user_id")

  /// Momento absoluto en que debe dispararse. El programador consulta por
  /// este índice; no recalcula offsets en cada barrido.
  remindAt DateTime @db.Timestamptz(6) @map("remind_at")
  channel  ReminderChannel @default(IN_APP)

  sentAt DateTime? @db.Timestamptz(6) @map("sent_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([remindAt, sentAt])
  @@index([tenantId, userId])
  @@map("reminder")
}

enum ReminderChannel {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH
}

/// Disponibilidad semanal de un usuario, para agendar reuniones.
model Availability {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  userId   String @db.Uuid @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 0 = domingo … 6 = sábado
  weekday   Int
  /// Minutos desde medianoche en la zona del usuario: 540 = 09:00
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  @@unique([tenantId, userId, weekday, startMinute])
  @@index([tenantId, userId])
  @@map("availability")
}

