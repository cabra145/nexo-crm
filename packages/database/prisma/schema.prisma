//  DOMINIO 6 · INTELIGENCIA ARTIFICIAL
// ============================================================================

model AiSource {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type   AiSourceType
  title  String         @db.VarChar(255)
  status AiSourceStatus @default(UPLOADED)

  fileId String? @map("file_id") @db.Uuid
  file   File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  url    String?

  /// Texto extraído completo. Se conserva para poder reindexar con otro
  /// tamaño de trozo sin volver a parsear el PDF.
  extractedText String? @map("extracted_text") @db.Text

  chunkCount Int @default(0) @map("chunk_count")
  tokenCount Int @default(0) @map("token_count")

  errorMessage String?   @map("error_message")
  indexedAt    DateTime? @map("indexed_at") @db.Timestamptz(6)

  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid

  chunks AiChunk[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@index([tenantId, deletedAt, createdAt(sort: Desc)])
  @@map("ai_source")
}

enum AiSourceType {
  PDF
  DOCX
  TXT
  MARKDOWN
  URL
  MANUAL
}

enum AiSourceStatus {
  UPLOADED
  PROCESSING
  INDEXED
  ERROR
}

/// Un trozo indexado con su vector. El `tenantId` NO es decorativo: la
/// búsqueda vectorial filtra por él y la política RLS lo respalda. Es el
/// motivo de tener los embeddings en Postgres y no en una base aparte.
model AiChunk {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  sourceId String   @map("source_id") @db.Uuid
  source   AiSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// Posición dentro del documento, para citar "página 4" y ordenar el contexto.
  chunkIndex Int    @map("chunk_index")
  content    String @db.Text
  tokens     Int    @default(0)

  /// Metadatos de cita: página, sección, encabezado.
  metadata Json? @db.JsonB

  /// text-embedding-3-small → 1536 dimensiones. Índice HNSW en la migración.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceId, chunkIndex])
  @@index([tenantId, sourceId])
  @@map("ai_chunk")
}

model AiThread {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title String? @db.VarChar(200)

  /// Un hilo puede nacer del asistente general o estar anclado a una
  /// conversación de WhatsApp (resumen, respuesta sugerida).
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  purpose AiPurpose @default(CHAT)

  messages AiMessage[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, userId, updatedAt(sort: Desc)])
  @@index([tenantId, conversationId])
  @@map("ai_thread")
}

enum AiPurpose {
  CHAT
  REPLY_SUGGESTION
  AUTO_REPLY
  SUMMARY
  ANALYSIS
  NEXT_STEP
  DRAFT
}

model AiMessage {
  id       String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  threadId String   @map("thread_id") @db.Uuid
  thread   AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  role    AiRole
  content String @db.Text

  /// Trozos usados como contexto. Es lo que permite mostrar "según el
  /// documento X, página 4" y lo que hace auditable la respuesta.
  citations Json? @db.JsonB

  model        String? @db.VarChar(60)
  tokensIn     Int     @default(0) @map("tokens_in")
  tokensOut    Int     @default(0) @map("tokens_out")
  latencyMs    Int?    @map("latency_ms")
  finishReason String? @map("finish_reason") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, threadId, createdAt])
  @@map("ai_message")
}

enum AiRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

/// Consumo de IA por empresa. La plataforma paga primero y cobra después:
/// sin esta tabla no hay forma de poner un techo ni de repercutir el coste.
model AiUsage {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  purpose AiPurpose
  model   String    @db.VarChar(60)

  tokensIn  Int     @default(0) @map("tokens_in")
  tokensOut Int     @default(0) @map("tokens_out")
  costUsd   Decimal @default(0) @map("cost_usd") @db.Decimal(10, 6)

  userId String? @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, purpose, createdAt])
  @@map("ai_usage")
}

model AiSetting {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  /// Instrucciones de la empresa: tono, nombre del asistente, qué no decir.
  /// Se inyectan en el prompt de sistema por encima de las reglas base, que
  /// no son sobrescribibles por el cliente.
  systemPrompt  String? @map("system_prompt") @db.Text
  assistantName String  @default("Asistente") @map("assistant_name") @db.VarChar(60)
  tone          String  @default("profesional") @db.VarChar(40)

  /// Responder solo, o sugerir y que el agente decida.
  autoReply             Boolean @default(false) @map("auto_reply")
  /// No responder sola si hay un humano asignado a la conversación.
  autoReplySkipAssigned Boolean @default(true) @map("auto_reply_skip_assigned")
  /// Horario fuera del cual sí responde sola (JSON con franjas por día).
  autoReplySchedule     Json?   @map("auto_reply_schedule") @db.JsonB

  chatModel        String  @default("gpt-4o-mini") @map("chat_model") @db.VarChar(60)
  embeddingModel   String  @default("text-embedding-3-small") @map("embedding_model") @db.VarChar(60)
  temperature      Decimal @default(0.3) @db.Decimal(3, 2)
  maxContextChunks Int     @default(6) @map("max_context_chunks")

  /// Techo mensual en dólares. Al alcanzarlo se corta, no se factura de más.
  monthlyBudgetUsd Decimal @default(0) @map("monthly_budget_usd") @db.Decimal(10, 2)

  /// Si la recuperación no alcanza este umbral de similitud, la IA no
  /// responde: deriva a un humano. Es la defensa contra la invención.
  minSimilarity Decimal @default(0.25) @map("min_similarity") @db.Decimal(4, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_setting")
}

// ============================================================================
//  DOMINIO 7 · AUTOMATIZACIONES
// ============================================================================

model Workflow {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String         @db.VarChar(120)
  description String?
  status      WorkflowStatus @default(DRAFT)

  /// Evento del bus que lo despierta: "contact.created", "deal.stage_changed",
  /// "whatsapp.message.received", "schedule.cron"…
  triggerType   String @map("trigger_type") @db.VarChar(60)
  /// Filtro del disparador: qué etapa, qué etiqueta, qué cron.
  triggerConfig Json   @default("{}") @map("trigger_config") @db.JsonB

  /// Versión publicada actualmente en ejecución.
  activeVersionId String? @unique @map("active_version_id") @db.Uuid

  /// Impide reinscribir al mismo contacto mientras ya está dentro del flujo.
  allowReenrollment Boolean @default(false) @map("allow_reenrollment")

  totalRuns  Int @default(0) @map("total_runs")
  failedRuns Int @default(0) @map("failed_runs")

  createdByUserId String? @map("created_by_user_id") @db.Uuid

  versions    WorkflowVersion[]
  runs        WorkflowRun[]
  enrollments WorkflowEnrollment[]

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@index([tenantId, triggerType, status])
  @@map("workflow")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// El grafo se versiona. Una ejecución en curso sigue usando la versión con
/// la que empezó: editar el flujo no rompe lo que ya está corriendo.
model WorkflowVersion {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  workflowId String   @map("workflow_id") @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  version Int

  /// Nodos y aristas del lienzo. Un solo jsonb porque el grafo se lee y se
  /// escribe entero: partirlo en dos tablas sólo añadiría joins.
  /// Validado contra un esquema zod antes de publicarse.
  graph Json @db.JsonB

  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  publishedByUserId String?   @map("published_by_user_id") @db.Uuid

  runs WorkflowRun[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([workflowId, version])
  @@index([tenantId, workflowId])
  @@map("workflow_version")
}

model WorkflowRun {
  id         String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  workflowId String          @map("workflow_id") @db.Uuid
  workflow   Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionId  String          @map("version_id") @db.Uuid
  version    WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  status RunStatus @default(PENDING)

  /// Qué disparó esta ejecución.
  triggerEvent String  @map("trigger_event") @db.VarChar(60)
  subjectType  String? @map("subject_type") @db.VarChar(40)
  subjectId    String? @map("subject_id") @db.Uuid

  /// Variables acumuladas: salida de cada nodo disponible para los siguientes.
  context Json @default("{}") @db.JsonB

  currentNodeId String?   @map("current_node_id") @db.VarChar(60)
  /// Cuándo despertar un nodo de espera. El programador lo consulta; una
  /// espera de 3 días no ocupa ningún proceso mientras tanto.
  resumeAt      DateTime? @map("resume_at") @db.Timestamptz(6)

  errorMessage String? @map("error_message")
  errorNodeId  String? @map("error_node_id") @db.VarChar(60)

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  steps WorkflowRunStep[]

  @@index([tenantId, workflowId, startedAt(sort: Desc)])
  @@index([status, resumeAt])
  @@index([tenantId, subjectType, subjectId])
  @@map("workflow_run")
}

enum RunStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

/// Un paso ejecutado. Persistir cada paso es lo que hace el motor reanudable
/// tras un reinicio y lo que permite responder "¿por qué este flujo no hizo
/// lo que esperaba?" — que es la diferencia entre una función usable y una
/// que se abandona.
model WorkflowRunStep {
  id       String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  runId    String      @map("run_id") @db.Uuid
  run      WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  nodeId   String     @map("node_id") @db.VarChar(60)
  nodeType String     @map("node_type") @db.VarChar(60)
  status   StepStatus @default(PENDING)

  input  Json? @db.JsonB
  output Json? @db.JsonB

  /// Para nodos de condición: qué rama se tomó y por qué.
  branchTaken String? @map("branch_taken") @db.VarChar(60)
  skipReason  String? @map("skip_reason")

  errorMessage String? @map("error_message")
  attempts     Int     @default(0)

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  durationMs  Int?      @map("duration_ms")

  @@index([tenantId, runId, startedAt])
  @@map("workflow_run_step")
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

/// Registro de qué contacto entró en qué flujo y cuándo. Hace cumplir
/// `allowReenrollment` sin escanear las ejecuciones.
model WorkflowEnrollment {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  workflowId String   @map("workflow_id") @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  runId String? @map("run_id") @db.Uuid

  enrolledAt DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  exitedAt   DateTime? @map("exited_at") @db.Timestamptz(6)
  exitReason String?   @map("exit_reason") @db.VarChar(60)

  @@index([tenantId, workflowId, contactId])
  @@index([tenantId, contactId])
  @@map("workflow_enrollment")
}

// ============================================================================
//  DOMINIO 8 · DOCUMENTOS COMERCIALES
//  Cotizaciones, proformas y facturas que las empresas emiten a SUS clientes.
//  Documento interno + PDF; sin firma fiscal (ver roadmap).
// ============================================================================

model Document {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind   DocumentKind
  /// Número visible al cliente: FAC-2026-00041. Generado con bloqueo de fila
  /// en `number_sequence` para que dos emisiones simultáneas nunca lo repitan.
  number String         @db.VarChar(40)
  status DocumentStatus @default(DRAFT)

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId    String?  @map("deal_id") @db.Uuid
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  /// Datos del cliente CONGELADOS al emitir. Si el contacto cambia de
  /// dirección mañana, la factura de ayer no se reescribe sola.
  billToName    String  @map("bill_to_name") @db.VarChar(200)
  billToTaxId   String? @map("bill_to_tax_id") @db.VarChar(40)
  billToEmail   String? @map("bill_to_email") @db.VarChar(255)
  billToAddress String? @map("bill_to_address")
  billToCity    String? @map("bill_to_city") @db.VarChar(120)
  billToCountry String? @map("bill_to_country") @db.Char(2)

  issueDate  DateTime  @default(now()) @map("issue_date") @db.Date
  dueDate    DateTime? @map("due_date") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date // para cotizaciones

  currency     String  @default("USD") @db.Char(3)
  /// Tipo de cambio a la moneda de la empresa en el momento de emitir.
  exchangeRate Decimal @default(1) @map("exchange_rate") @db.Decimal(12, 6)

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)

  notes String? @db.Text
  terms String? @db.Text

  templateId String?      @map("template_id") @db.Uuid
  template   DocTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  pdfFileId String? @map("pdf_file_id") @db.Uuid
  pdfFile   File?   @relation(fields: [pdfFileId], references: [id], onDelete: SetNull)

  sentAt     DateTime? @map("sent_at") @db.Timestamptz(6)
  viewedAt   DateTime? @map("viewed_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  paidAt     DateTime? @map("paid_at") @db.Timestamptz(6)
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(6)

  /// Documento del que nace (cotización → factura).
  convertedFromId String? @map("converted_from_id") @db.Uuid

  createdByUserId String? @map("created_by_user_id") @db.Uuid

  items    DocumentItem[]
  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, kind, number])
  @@index([tenantId, kind, status, issueDate(sort: Desc)])
  @@index([tenantId, contactId])
  @@index([tenantId, dealId])
  @@index([tenantId, status, dueDate])
  @@map("document")
}

enum DocumentKind {
  QUOTE
  PROFORMA
  INVOICE
  CREDIT_NOTE
}

enum DocumentStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model DocumentItem {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name        String  @db.VarChar(200)
  description String?
  quantity    Decimal @db.Decimal(12, 3)
  unit        String  @default("unidad") @db.VarChar(30)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)

  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)

  taxRateId  String?  @map("tax_rate_id") @db.Uuid
  taxRate    TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  /// Porcentaje congelado al emitir: si el IVA sube, la factura vieja no cambia.
  taxPercent Decimal  @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount  Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)

  subtotal Decimal @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  sortOrder Int @default(0) @map("sort_order")

  @@index([tenantId, documentId, sortOrder])
  @@map("document_item")
}

model Payment {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  amount   Decimal       @db.Decimal(14, 2)
  currency String        @default("USD") @db.Char(3)
  method   PaymentMethod @default(TRANSFER)

  reference String?  @db.VarChar(120)
  notes     String?
  paidAt    DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)

  recordedByUserId String? @map("recorded_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, documentId])
  @@index([tenantId, paidAt(sort: Desc)])
  @@map("payment")
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CHECK
  CRYPTO
  OTHER
}

model TaxRate {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(60) // "IVA 15%"
  percent   Decimal @db.Decimal(5, 2)
  isDefault Boolean @default(false) @map("is_default")
  active    Boolean @default(true)

  products      Product[]
  documentItems DocumentItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("tax_rate")
}

/// Contador por serie y tipo de documento. El servicio lo lee con
/// SELECT ... FOR UPDATE dentro de la transacción de emisión: es la única
/// forma de que dos facturas simultáneas no compartan número.
model NumberSequence {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind   DocumentKind
  /// Serie/establecimiento. "001" por defecto.
  series String       @default("001") @db.VarChar(10)
  year   Int

  prefix  String @default("") @db.VarChar(20)
  padding Int    @default(5)
  current Int    @default(0)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, kind, series, year])
  @@map("number_sequence")
}

model DocTemplate {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String       @db.VarChar(80)
  kind      DocumentKind
  isDefault Boolean      @default(false) @map("is_default")

  /// Colores, logo, pie de página, columnas visibles. La plantilla React del
  /// PDF lee esto; no hay HTML libre del usuario (superficie de XSS).
  design Json @default("{}") @db.JsonB

  headerNote String? @map("header_note") @db.Text
  footerNote String? @map("footer_note") @db.Text

  documents Document[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, kind, name])
  @@map("doc_template")
}

