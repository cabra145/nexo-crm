// ============================================================================
//  Nexo CRM · Esquema de datos
// ----------------------------------------------------------------------------
//  Convenciones que rigen TODO este archivo:
//
//  1. Toda tabla de negocio lleva `tenantId` y una política RLS en
//     migrations/*_rls/migration.sql. La columna sola no aísla nada: el
//     aislamiento real lo impone Postgres.
//  2. Las claves primarias son UUID v7 (ordenables por tiempo) generadas por
//     `uuid_generate_v7()`, creada en la migración inicial.
//  3. Todo índice sobre una tabla con ámbito de empresa empieza por `tenantId`.
//     Sin eso, Postgres recorre filas de otras empresas antes de descartarlas.
//  4. Borrado lógico (`deletedAt`) sólo donde el usuario puede arrepentirse.
//     Lo demás se borra de verdad, en cascada.
//  5. Los importes son Decimal(14,2) y nunca Float. El dinero no es binario.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  // Rol `nexo_app`: lo usa la aplicación. Sin BYPASSRLS y sin permiso para
  // alterar el esquema.
  url        = env("DATABASE_URL")
  // Rol dueño: lo usa Prisma Migrate. Sin esto, las migraciones intentarían
  // crear tablas con `nexo_app`, que a propósito no puede hacerlo.
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, vector, btree_gin]
}

// ============================================================================
//  DOMINIO 1 · PLATAFORMA
//  Vive por encima de las empresas. Sin `tenantId`, sin RLS: son los datos
//  del negocio SaaS, no de sus clientes.
// ============================================================================

model Plan {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code        String  @unique // "free" | "starter" | "pro" | "business"
  name        String
  description String?

  priceMonthly Decimal @default(0) @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal @default(0) @map("price_yearly") @db.Decimal(10, 2)
  currency     String  @default("USD") @db.Char(3)

  // Límites aplicados en caliente por el guard de cuotas.
  // -1 = ilimitado. Se leen desde caché de Redis, no de la BD, en cada petición.
  maxUsers         Int @default(3) @map("max_users")
  maxContacts      Int @default(1000) @map("max_contacts")
  maxChannels      Int @default(1) @map("max_channels")
  maxWorkflows     Int @default(3) @map("max_workflows")
  maxAiSources     Int @default(10) @map("max_ai_sources")
  maxStorageMb     Int @default(1024) @map("max_storage_mb")
  monthlyAiCredits Int @default(0) @map("monthly_ai_credits")
  monthlyMessages  Int @default(1000) @map("monthly_messages")

  isPublic  Boolean @default(true) @map("is_public") // visible en la página de precios
  isDefault Boolean @default(false) @map("is_default") // asignado al registrarse
  trialDays Int     @default(14) @map("trial_days")
  sortOrder Int     @default(0) @map("sort_order")

  features      PlanFeature[]
  subscriptions Subscription[]

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  @@index([isPublic, sortOrder])
  @@map("plan")
}

/// Banderas de funcionalidad por plan. Separadas de los límites numéricos
/// porque se consultan distinto: "¿puede usar IA?" vs "¿cuántos contactos?".
model PlanFeature {
  id     String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  planId String @map("plan_id") @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  key     String // "ai.rag" | "automation.visual" | "whatsapp" | "api.public" | "custom_roles"
  enabled Boolean @default(true)
  config  Json?   @db.JsonB

  @@unique([planId, key])
  @@map("plan_feature")
}

/// La empresa. Raíz de todo el aislamiento del sistema.
model Tenant {
  id   String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug String @unique @db.VarChar(63) // subdominio y segmento de URL: /w/acme
  name String @db.VarChar(160)

  status TenantStatus @default(TRIAL)

  // Identidad visual, usada en la app, los correos y los PDFs.
  logoUrl     String? @map("logo_url")
  brandColor  String? @map("brand_color") @db.VarChar(9)
  legalName   String? @map("legal_name") @db.VarChar(200)
  taxId       String? @map("tax_id") @db.VarChar(40)
  addressLine String? @map("address_line")
  city        String? @db.VarChar(120)
  country     String? @db.Char(2)
  phone       String? @db.VarChar(32)
  website     String?

  timezone String @default("America/Guayaquil") @db.VarChar(64)
  locale   String @default("es") @db.VarChar(10)
  currency String @default("USD") @db.Char(3)

  /// Ajustes libres del espacio de trabajo. Se cachean en Redis y se
  /// invalidan por evento; nunca se leen dentro de un bucle.
  settings Json @default("{}") @db.JsonB

  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspendedReason String?   @map("suspended_reason")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription    Subscription?
  memberships     Membership[]
  roles           Role[]
  usage           TenantUsage[]
  apiKeys         ApiKey[]
  auditLogs       AuditLog[]
  contacts        Contact[]
  companies       Company[]
  tags            Tag[]
  customFields    CustomField[]
  notes           Note[]
  activities      Activity[]
  pipelines       Pipeline[]
  deals           Deal[]
  products        Product[]
  lostReasons     LostReason[]
  channels        Channel[]
  conversations   Conversation[]
  messages        Message[]
  waTemplates     WaTemplate[]
  aiSources       AiSource[]
  aiThreads       AiThread[]
  aiUsage         AiUsage[]
  aiSetting       AiSetting?
  workflows       Workflow[]
  documents       Document[]
  taxRates        TaxRate[]
  numberSequences NumberSequence[]
  docTemplates    DocTemplate[]
  tasks           Task[]
  events          Event[]
  dashboards      Dashboard[]
  savedViews      SavedView[]
  notifications   Notification[]
  files           File[]
  outboundHooks   OutboundWebhook[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenant")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Subscription {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId String @map("plan_id") @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id])

  status   SubscriptionStatus @default(TRIALING)
  interval PlanInterval       @default(MONTHLY)

  // Referencias a la pasarela. Nulas hasta la Fase 5: el modelo está
  // preparado pero ningún cobro está acoplado todavía.
  providerName           String? @map("provider_name") @db.VarChar(40)
  providerCustomerId     String? @map("provider_customer_id") @db.VarChar(120)
  providerSubscriptionId String? @unique @map("provider_subscription_id") @db.VarChar(120)

  currentPeriodStart DateTime  @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at") @db.Timestamptz(6)

  /// Sobrescribe límites del plan para un cliente concreto (acuerdos a medida).
  /// Se fusiona por encima del plan al calcular cuotas.
  limitOverrides Json? @map("limit_overrides") @db.JsonB

  invoices SubscriptionInvoice[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Destino de la clave foránea compuesta de subscription_invoice.
  @@unique([tenantId, id])
  @@index([status, currentPeriodEnd])
  @@map("subscription")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

/// Facturas que la plataforma emite a sus empresas cliente.
/// Distinto de `Document`, que son las facturas que las empresas emiten a los suyos.
model SubscriptionInvoice {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  /// Empresa facturada. Antes la tabla estaba excluida del aislamiento a mano,
  /// pero guarda las facturas de cada empresa: es dato de empresa y lleva RLS.
  tenantId       String       @map("tenant_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  /// FK compuesta: la factura y su suscripción pertenecen a la misma empresa.
  subscription   Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)

  number   String    @unique @db.VarChar(40)
  amount   Decimal   @db.Decimal(12, 2)
  currency String    @default("USD") @db.Char(3)
  status   String    @default("open") @db.VarChar(20) // open | paid | void | uncollectible
  paidAt   DateTime? @map("paid_at") @db.Timestamptz(6)
  dueAt    DateTime? @map("due_at") @db.Timestamptz(6)
  pdfUrl   String?   @map("pdf_url")

  providerInvoiceId String? @unique @map("provider_invoice_id") @db.VarChar(120)

  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([subscriptionId, createdAt])
  @@index([status, dueAt])
  @@map("subscription_invoice")
}

/// Consumo agregado por empresa y día. Alimenta los límites de plan y el
/// panel de plataforma sin tener que contar filas en tablas grandes.
model TenantUsage {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  day DateTime @db.Date

  activeUsers     Int     @default(0) @map("active_users")
  contactCount    Int     @default(0) @map("contact_count")
  messagesIn      Int     @default(0) @map("messages_in")
  messagesOut     Int     @default(0) @map("messages_out")
  aiTokensIn      Int     @default(0) @map("ai_tokens_in")
  aiTokensOut     Int     @default(0) @map("ai_tokens_out")
  aiCostUsd       Decimal @default(0) @map("ai_cost_usd") @db.Decimal(10, 4)
  workflowRuns    Int     @default(0) @map("workflow_runs")
  documentsIssued Int     @default(0) @map("documents_issued")
  storageMb       Int     @default(0) @map("storage_mb")
  apiCalls        Int     @default(0) @map("api_calls")

  @@unique([tenantId, day])
  @@index([day])
  @@map("tenant_usage")
}

/// Operadores de la plataforma. Tabla aparte de `User` a propósito: un
/// superadmin no es un usuario con una bandera, es una entidad distinta con
/// otro ciclo de vida, otro login y 2FA obligatorio.
model PlatformAdmin {
  id           String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email        String @unique @db.VarChar(255)
  passwordHash String @map("password_hash")
  name         String @db.VarChar(120)

  totpSecret    String?  @map("totp_secret") // cifrado AES-256-GCM en la capa de aplicación
  totpEnabled   Boolean  @default(false) @map("totp_enabled")
  recoveryCodes String[] @map("recovery_codes") // hashes, de un solo uso

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp String?   @map("last_login_ip") @db.Inet
  disabledAt  DateTime? @map("disabled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_admin")
}

// ============================================================================
//  DOMINIO 2 · IDENTIDAD Y ACCESO
// ============================================================================

/// Una persona. Puede pertenecer a varias empresas: `User` no lleva `tenantId`.
/// La relación con la empresa vive en `Membership`.
model User {
  id           String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email        String  @unique @db.VarChar(255)
  passwordHash String? @map("password_hash")
  name         String  @db.VarChar(120)
  avatarUrl    String? @map("avatar_url")
  phone        String? @db.VarChar(32)
  locale       String  @default("es") @db.VarChar(10)
  timezone     String? @db.VarChar(64)

  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)

  totpEnabled   Boolean  @default(false) @map("totp_enabled")
  recoveryCodes String[] @map("recovery_codes") // hashes Argon2 de un solo uso

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp String?   @map("last_login_ip") @db.Inet

  /// Intentos fallidos consecutivos. El bloqueo real lo hace el limitador de
  /// tasa en Redis; esto es para mostrárselo al usuario y auditarlo.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)

  /// Preferencias de interfaz: tema, densidad de tabla, columnas visibles.
  preferences Json @default("{}") @db.JsonB

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships   Membership[]
  refreshTokens RefreshToken[]
  totp          TotpSecret?
  emailTokens   EmailToken[]
  notifications Notification[]

  ownedContacts      Contact[]      @relation("ContactOwner")
  ownedDeals         Deal[]         @relation("DealOwner")
  assignedConvos     Conversation[] @relation("ConversationAssignee")
  assignedTasks      Task[]         @relation("TaskAssignee")
  createdTasks       Task[]         @relation("TaskCreator")
  authoredNotes      Note[]
  authoredActivities Activity[]
  organizedEvents    Event[]        @relation("EventOrganizer")
  uploadedFiles      File[]
  aiThreads          AiThread[]
  availability       Availability[]

  @@index([status])
  @@index([deletedAt])
  @@map("user")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

/// La pertenencia de un usuario a una empresa, con su rol.
/// Es la tabla que el guard de tenant consulta en CADA petición (cacheada).
model Membership {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  status MembershipStatus @default(INVITED)

  /// Equipo al que pertenece. Determina el alcance "su equipo" del rol MANAGER.
  teamName String? @map("team_name") @db.VarChar(80)

  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  invitedAt       DateTime  @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@map("membership")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Rol dentro de una empresa. Los cinco del sistema se crean con cada empresa
/// (`isSystem = true`, no editables); los planes altos pueden crear más.
model Role {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key         SystemRole
  name        String     @db.VarChar(80)
  description String?
  isSystem    Boolean    @default(false) @map("is_system")

  memberships Membership[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, name])
  /// Destino de la clave foránea compuesta de role_permission. `id` ya es
  /// único por sí solo; este índice existe para garantizar la empresa.
  @@unique([tenantId, id])
  @@map("role")
}

enum SystemRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
  CUSTOM
}

/// Un permiso concedido a un rol. `permission` es la cadena granular
/// ("contact:read", "deal:delete", "billing:manage") y `scope` responde a
/// "¿sobre qué filas?" — la distinción entre un Manager y un Agente.
model RolePermission {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  /// Empresa del rol. Sin esta columna la tabla quedaba fuera de RLS: se
  /// llegaba a la empresa sólo a través de `role`, y una consulta directa a
  /// role_permission veía la configuración de permisos de todas las empresas.
  tenantId String @map("tenant_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  /// Clave foránea COMPUESTA (tenant_id, role_id) → role(tenant_id, id).
  /// No basta con que el rol exista: tiene que ser DE LA MISMA EMPRESA. Así es
  /// imposible, a nivel de base de datos, colgar un permiso con el tenant_id
  /// de una empresa de un rol de otra.
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  permission String          @db.VarChar(64)
  scope      PermissionScope @default(ALL)

  @@unique([roleId, permission])
  @@index([tenantId, roleId])
  @@map("role_permission")
}

enum PermissionScope {
  ALL // toda la empresa
  TEAM // registros de su equipo
  OWN // sólo los que le pertenecen
}

/// Familia de tokens de refresco. La rotación con detección de reuso vive aquí:
/// si llega un token ya consumido, se revoca toda la familia.
model RefreshToken {
  id     String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 del token. El valor en claro sólo existe en la cookie del cliente.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  /// Identificador de familia: todos los tokens nacidos de un mismo login.
  familyId String @map("family_id") @db.Uuid

  /// Empresa activa cuando se emitió. Cambiar de espacio emite un token nuevo.
  tenantId String? @map("tenant_id") @db.Uuid

  userAgent String? @map("user_agent")
  ip        String? @db.Inet

  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(60) // "rotation" | "reuse_detected" | "logout" | "password_change"

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model TotpSecret {
  id     String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Cifrado con AES-256-GCM. La clave maestra vive fuera de la base de datos.
  secretEncrypted String    @map("secret_encrypted")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("totp_secret")
}

/// Tokens de un solo uso: verificación de correo, recuperación de contraseña
/// e invitaciones. Una tabla en vez de tres porque el ciclo de vida es idéntico.
model EmailToken {
  id     String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String            @unique @map("token_hash") @db.VarChar(64)
  purpose   EmailTokenPurpose

  /// Contexto extra: para invitaciones, la empresa y el rol propuestos.
  payload Json? @db.JsonB

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_token")
}

enum EmailTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
  EMAIL_CHANGE
}

/// Claves de la API pública, por empresa.
model ApiKey {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String   @db.VarChar(80)
  /// Prefijo visible para que el usuario identifique la clave sin revelarla.
  prefix  String   @unique @db.VarChar(16)
  keyHash String   @unique @map("key_hash") @db.VarChar(64)
  scopes  String[]

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, revokedAt])
  @@map("api_key")
}

/// Registro inmutable. Se escribe desde el worker vía cola para no penalizar
/// la petición del usuario. Particionado por mes en la migración.
model AuditLog {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorEmail  String?   @map("actor_email") @db.VarChar(255)
  actorType   ActorType @default(USER) @map("actor_type")

  action        AuditAction
  resourceType  String      @map("resource_type") @db.VarChar(60)
  resourceId    String?     @map("resource_id") @db.Uuid
  resourceLabel String?     @map("resource_label") @db.VarChar(200)

  /// Diferencia de valores { campo: { antes, despues } }. Campos sensibles
  /// redactados por el serializador antes de llegar aquí.
  changes Json? @db.JsonB

  ip        String? @db.Inet
  userAgent String? @map("user_agent")
  traceId   String? @map("trace_id") @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, actorUserId, createdAt(sort: Desc)])
  @@map("audit_log")
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
  AUTOMATION
  SUPPORT // suplantación con consentimiento
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  TWO_FACTOR_ENABLE
  TWO_FACTOR_DISABLE
  EXPORT
  IMPORT
  INVITE
  ROLE_CHANGE
  IMPERSONATE_START
  IMPERSONATE_END
  SETTINGS_CHANGE
  SEND
}

