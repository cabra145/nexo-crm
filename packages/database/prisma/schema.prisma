/// Cuenta / organización cliente. Distinta de `Tenant`: Tenant es quien usa
/// Nexo, Company es a quién le vende.
model Company {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(200)
  legalName String? @map("legal_name") @db.VarChar(200)
  taxId     String? @map("tax_id") @db.VarChar(40)
  industry  String? @db.VarChar(80)
  size      String? @db.VarChar(40)
  website   String?
  phone     String? @db.VarChar(32)
  email     String? @db.VarChar(255)

  addressLine String? @map("address_line")
  city        String? @db.VarChar(120)
  state       String? @db.VarChar(120)
  postalCode  String? @map("postal_code") @db.VarChar(20)
  country     String? @db.Char(2)

  custom Json @default("{}") @db.JsonB

  contacts  Contact[]
  deals     Deal[]
  documents Document[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
  @@map("company")
}

/// La persona con la que se habla. Entidad central del CRM.
model Contact {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firstName String  @map("first_name") @db.VarChar(80)
  lastName  String? @map("last_name") @db.VarChar(80)
  /// La calcula un trigger BEFORE a partir de firstName + lastName; el valor
  /// que mande la aplicación se ignora. Por eso lleva default: para que crear
  /// un contacto no obligue a componerlo en el cliente.
  fullName  String  @default("") @map("full_name") @db.VarChar(165)

  jobTitle String? @map("job_title") @db.VarChar(120)

  companyId   String?  @map("company_id") @db.Uuid
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Nombre de empresa libre, para contactos sin cuenta formal creada.
  companyName String?  @map("company_name") @db.VarChar(200)

  email        String? @db.VarChar(255)
  /// SIEMPRE normalizado a E.164 (+593987654321). La deduplicación de la
  /// importación y el emparejamiento de WhatsApp dependen de esta invariante.
  phoneE164    String? @map("phone_e164") @db.VarChar(20)
  whatsappE164 String? @map("whatsapp_e164") @db.VarChar(20)

  addressLine String? @map("address_line")
  city        String? @db.VarChar(120)
  state       String? @db.VarChar(120)
  postalCode  String? @map("postal_code") @db.VarChar(20)
  country     String? @db.Char(2)

  lifecycleStage LifecycleStage @default(LEAD) @map("lifecycle_stage")
  source         String?        @db.VarChar(80) // "whatsapp" | "import" | "web" | "manual" | "api"

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Valores de los campos que la empresa definió en `CustomField`.
  /// jsonb + índice GIN en vez de EAV: se filtra con operadores nativos.
  custom Json @default("{}") @db.JsonB

  /// Columna tsvector generada en la migración (Prisma no la expresa).
  /// Índice GIN + trigram sobre fullName y phoneE164.
  searchVector Unsupported("tsvector")? @map("search_vector")

  lastActivityAt  DateTime? @map("last_activity_at") @db.Timestamptz(6)
  lastContactedAt DateTime? @map("last_contacted_at") @db.Timestamptz(6)

  tags          ContactTag[]
  deals         Deal[]
  conversations Conversation[]
  identities    ContactIdentity[]
  notes         Note[]
  activities    Activity[]
  tasks         Task[]
  documents     Document[]
  fieldValues   CustomFieldValue[]
  enrollments   WorkflowEnrollment[]
  eventLinks    Event[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, deletedAt, createdAt(sort: Desc)])
  @@index([tenantId, ownerId])
  @@index([tenantId, companyId])
  @@index([tenantId, lifecycleStage])
  @@index([tenantId, lastActivityAt(sort: Desc)])
  // La unicidad de correo y teléfono NO se declara aquí: debe ignorar los
  // contactos borrados (borrar a juan@x.com tiene que permitir recrearlo) y
  // eso exige un índice PARCIAL, que Prisma no expresa. Vive en
  // sql/02_search_and_indexes.sql · contact_tenant_{email,phone}_live_key.
  @@map("contact")
}

enum LifecycleStage {
  LEAD
  PROSPECT
  CUSTOMER
  EVANGELIST
  CHURNED
  OTHER
}

model Tag {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String @db.VarChar(60)
  color String @default("#6B7280") @db.VarChar(9)

  contacts ContactTag[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tag")
}

model ContactTag {
  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String  @map("tag_id") @db.Uuid
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tenantId  String  @map("tenant_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([contactId, tagId])
  @@index([tagId])
  @@index([tenantId])
  @@map("contact_tag")
}

/// Definición de un campo personalizado: tipo, etiqueta, opciones.
/// Valida las escrituras y dibuja el formulario.
model CustomField {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  entity EntityType
  /// Clave dentro del jsonb `custom`. Inmutable una vez creada.
  key    String     @db.VarChar(50)
  label  String     @db.VarChar(80)
  type   FieldType

  options    Json?   @db.JsonB // para SELECT y MULTISELECT
  required   Boolean @default(false)
  helpText   String? @map("help_text")
  sortOrder  Int     @default(0) @map("sort_order")
  showInList Boolean @default(false) @map("show_in_list")

  values CustomFieldValue[]

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  @@unique([tenantId, entity, key])
  @@index([tenantId, entity, sortOrder])
  @@map("custom_field")
}

enum EntityType {
  CONTACT
  COMPANY
  DEAL
  TASK
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  DATE
  DATETIME
  BOOLEAN
  SELECT
  MULTISELECT
  EMAIL
  PHONE
  URL
  USER
}

/// Índice invertido de los valores personalizados. El dato vivo está en el
/// jsonb de la entidad; esta tabla existe para poder ordenar y agregar por un
/// campo concreto sin escanear el jsonb de toda la tabla.
model CustomFieldValue {
  id       String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  fieldId  String      @map("field_id") @db.Uuid
  field    CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?  @map("deal_id") @db.Uuid
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  valueText   String?   @map("value_text")
  valueNumber Decimal?  @map("value_number") @db.Decimal(18, 4)
  valueDate   DateTime? @map("value_date") @db.Timestamptz(6)
  valueBool   Boolean?  @map("value_bool")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([fieldId, contactId])
  @@unique([fieldId, dealId])
  @@index([tenantId, fieldId, valueText])
  @@index([tenantId, fieldId, valueNumber])
  @@map("custom_field_value")
}

model Note {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  body String @db.Text

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?  @map("deal_id") @db.Uuid
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Menciones a usuarios, para notificarles.
  mentions String[] @db.Uuid

  pinned Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, contactId, createdAt(sort: Desc)])
  @@index([tenantId, dealId, createdAt(sort: Desc)])
  @@map("note")
}

/// Timeline unificada. La escriben los suscriptores del bus de eventos, no
/// cada módulo a mano: por eso un módulo nuevo aparece en la ficha del
/// contacto sin tocar este código.
model Activity {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type ActivityType

  /// Referencia polimórfica al objeto que originó la actividad.
  subjectType String  @map("subject_type") @db.VarChar(40)
  subjectId   String? @map("subject_id") @db.Uuid

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?  @map("deal_id") @db.Uuid
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  actorId   String?   @map("actor_id") @db.Uuid
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorType ActorType @default(USER) @map("actor_type")

  title   String  @db.VarChar(200)
  summary String?
  /// Carga útil específica del tipo: etapa anterior y nueva, importe, etc.
  payload Json?   @db.JsonB

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, contactId, occurredAt(sort: Desc)])
  @@index([tenantId, dealId, occurredAt(sort: Desc)])
  @@index([tenantId, type, occurredAt(sort: Desc)])
  @@map("activity")
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  TASK
  STAGE_CHANGE
  FIELD_CHANGE
  DOCUMENT
  PAYMENT
  AUTOMATION
  AI
  SYSTEM
}

