enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Event {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(200)
  description String? @db.Text
  location    String? @db.VarChar(255)
  meetingUrl  String? @map("meeting_url")

  type EventType @default(MEETING)

  /// Siempre en UTC. La zona en la que se creó se guarda aparte para poder
  /// mostrar "10:00 hora de Quito" aunque el que mira esté en Madrid.
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)
  timezone String   @default("America/Guayaquil") @db.VarChar(64)
  allDay   Boolean  @default(false) @map("all_day")

  /// Regla de recurrencia RFC 5545 (RRULE). Las instancias no se materializan:
  /// se expanden al consultar un rango, y las excepciones viven en
  /// `recurrenceExceptions` para que editar un día no corrompa la serie.
  recurrenceRule       String?    @map("recurrence_rule") @db.VarChar(255)
  recurrenceExceptions DateTime[] @map("recurrence_exceptions") @db.Timestamptz(6)
  /// Para una instancia modificada de una serie.
  recurringEventId     String?    @map("recurring_event_id") @db.Uuid

  organizerId String? @map("organizer_id") @db.Uuid
  organizer   User?   @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId    String?  @map("deal_id") @db.Uuid
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  status EventStatus @default(CONFIRMED)

  attendees EventAttendee[]
  reminders Reminder[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, startsAt])
  @@index([tenantId, organizerId, startsAt])
  @@index([tenantId, contactId])
  @@map("event")
}

enum EventType {
  MEETING
  CALL
  FOLLOW_UP
  DEMO
  OTHER
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

model EventAttendee {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  eventId  String @map("event_id") @db.Uuid
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Puede ser un usuario del equipo o un invitado externo por correo.
  userId    String? @map("user_id") @db.Uuid
  contactId String? @map("contact_id") @db.Uuid
  email     String? @db.VarChar(255)
  name      String? @db.VarChar(120)

  response    AttendeeResponse @default(NEEDS_ACTION)
  isOrganizer Boolean          @default(false) @map("is_organizer")

  @@unique([eventId, email])
  @@index([tenantId, eventId])
  @@map("event_attendee")
}

enum AttendeeResponse {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

model Reminder {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  taskId  String? @map("task_id") @db.Uuid
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  eventId String? @map("event_id") @db.Uuid
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid

  /// Momento absoluto en que debe dispararse. El programador consulta por
  /// este índice; no recalcula offsets en cada barrido.
  remindAt DateTime        @map("remind_at") @db.Timestamptz(6)
  channel  ReminderChannel @default(IN_APP)

  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([remindAt, sentAt])
  @@index([tenantId, userId])
  @@map("reminder")
}

enum ReminderChannel {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH
}

/// Disponibilidad semanal de un usuario, para agendar reuniones.
model Availability {
  id       String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 0 = domingo … 6 = sábado
  weekday     Int
  /// Minutos desde medianoche en la zona del usuario: 540 = 09:00
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  @@unique([tenantId, userId, weekday, startMinute])
  @@index([tenantId, userId])
  @@map("availability")
}

