  checksum     String? @db.VarChar(64)

  purpose FilePurpose @default(ATTACHMENT)

  uploadedById String? @db.Uuid @map("uploaded_by_id")
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

