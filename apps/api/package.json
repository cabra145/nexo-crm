{
  "name": "@nexo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo",
    "lint": "eslint . --max-warnings=0",
    "crypto:selftest": "tsx scripts/crypto-selftest.ts",
    "auth:e2e": "tsx scripts/auth-e2e.ts",
    "rbac:e2e": "tsx scripts/rbac-e2e.ts",
    "crm:e2e": "tsx scripts/crm-e2e.ts",
    "deals:e2e": "tsx scripts/deals-e2e.ts",
    "whatsapp:e2e": "tsx scripts/whatsapp-e2e.ts",
    "inbox:e2e": "tsx scripts/inbox-e2e.ts",
    "media:e2e": "tsx scripts/media-e2e.ts",
    "templates:e2e": "tsx scripts/templates-e2e.ts",
    "verify:whatsapp": "node --env-file-if-exists=../../.env --import tsx scripts/verify-whatsapp.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@nexo/contracts": "workspace:*",
    "@nexo/database": "workspace:*",
    "@nexo/storage": "workspace:*",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nexo/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
