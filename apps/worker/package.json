{
  "name": "@nexo/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-test.ts",
    "clean": "rm -rf dist node_modules .turbo",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@nexo/contracts": "workspace:*",
    "@nexo/database": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "nodemailer": "8.0.11",
    "pino": "10.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nexo/config": "workspace:*",
    "@types/node": "26.5.1",
    "@types/nodemailer": "8.0.1",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
