###############################################################################
#  Nexo CRM · Configuración de entorno
# -----------------------------------------------------------------------------
#  Copia este archivo a `.env` y rellena lo marcado como OBLIGATORIO.
#
#      cp .env.example .env
#
#  Todo esto se valida con zod al arrancar (packages/contracts/src/env.ts).
#  Si falta algo o está mal, el proceso NO levanta y te dice exactamente qué.
#  Es a propósito: mejor un arranque fallido en dos segundos que descubrir a
#  las tres horas que los correos no salían.
#
#  `.env` está en .gitignore. Nunca lo subas.
###############################################################################

NODE_ENV=development
LOG_LEVEL=debug


# =============================================================================
#  BASE DE DATOS                                                    OBLIGATORIO
# -----------------------------------------------------------------------------
#  Dos conexiones, y la separación importa:
#
#    DATABASE_URL         rol `nexo_app`  · SIN BYPASSRLS · lo usa la aplicación
#    DIRECT_DATABASE_URL  rol dueño       · migraciones y scripts SQL
#
#  Si la aplicación conectara con el rol dueño, `FORCE ROW LEVEL SECURITY` no
#  la afectaría y todo el aislamiento entre empresas sería decorativo.
#
#  En desarrollo con Docker Compose ambas apuntan al mismo contenedor, pero con
#  usuarios distintos. En producción DEBEN ser roles distintos.
# =============================================================================
DATABASE_URL="postgresql://nexo_app:cambia_esta_clave@localhost:5432/nexo?schema=public&connection_limit=20&pool_timeout=20"
DIRECT_DATABASE_URL="postgresql://nexo:cambia_esta_clave@localhost:5432/nexo?schema=public"

# Contraseñas que usa docker compose al crear el contenedor de Postgres.
POSTGRES_DB=nexo
POSTGRES_USER=nexo
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_APP_PASSWORD=cambia_esta_clave


# =============================================================================
#  REDIS                                                            OBLIGATORIO
# -----------------------------------------------------------------------------
#  Colas (BullMQ), caché de permisos y planes, contadores de límite de tasa y
#  el adaptador de Socket.IO que permite tener varias instancias de la API.
# =============================================================================
REDIS_URL="redis://localhost:6379"
# REDIS_PASSWORD=   # en producción, siempre


# =============================================================================
#  SECRETOS                                                         OBLIGATORIO
# -----------------------------------------------------------------------------
#  Genera CADA UNO por separado. Reutilizar el mismo valor en dos sitios
#  convierte una filtración en tres.
#
#      openssl rand -hex 32     → ENCRYPTION_KEY (exactamente 64 caracteres hex)
#      openssl rand -base64 48  → los secretos JWT
# =============================================================================

# Cifrado en reposo: tokens de WhatsApp de cada empresa, secretos TOTP,
# secretos de webhook. Si pierdes esta clave, esos datos son irrecuperables.
# Guárdala fuera de la base de datos y fuera del repositorio.
ENCRYPTION_KEY=""

# Firma de los tokens de sesión. DISTINTOS entre sí: si se filtra el de acceso,
# no debe servir para forjar uno de refresco.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d


# =============================================================================
#  RED
# =============================================================================
API_PORT=4000
APP_URL="http://localhost:3000"

# Dirección de la API que usa el NAVEGADOR. Todo lo que empieza por
# NEXT_PUBLIC_ se incrusta en el código de la web y cualquiera puede leerlo:
# nunca pongas un secreto en una variable con ese prefijo.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Dominio de la cookie de refresco. Vacío = el host actual.
# En producción con subdominios por empresa: ".tudominio.com"
COOKIE_DOMAIN=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300


# =============================================================================
#  CORREO TRANSACCIONAL
# -----------------------------------------------------------------------------
#  Sin esto NO funcionan: verificación de correo, recuperación de contraseña ni
#  invitaciones al equipo. Es decir, nadie puede terminar de registrarse.
#
#  En desarrollo, el Compose levanta Mailpit y los correos se leen en
#  http://localhost:8025 sin salir a internet.
# =============================================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Nexo CRM <no-responder@nexo.test>"


# =============================================================================
#  ALMACENAMIENTO DE OBJETOS
# -----------------------------------------------------------------------------
#  Adjuntos de WhatsApp, PDFs de documentos, fuentes de la IA, avatares.
#  Cualquier servicio compatible con S3; cambiar de uno a otro es cambiar
#  estas variables, no código (paquete @nexo/storage).
#
#    r2     Cloudflare R2 (por defecto, producción). Basta R2_ACCOUNT_ID: el
#           endpoint, la región (auto) y el estilo de ruta se deducen.
#    s3     Amazon S3. Sin endpoint; indica S3_REGION.
#    minio  MinIO (desarrollo, de infra/compose.yml). Exige S3_ENDPOINT.
#
#  El bucket es PRIVADO: todo se sirve con URL firmadas de vida corta.
#  En producción, sin credenciales o con un endpoint que no sea https, la API
#  y el worker no arrancan.
# =============================================================================
STORAGE_PROVIDER=minio
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET=nexo
S3_ACCESS_KEY=nexo_minio
S3_SECRET_KEY=cambia_esta_clave
# Sólo con r2: el identificador de cuenta de Cloudflare (panel de R2).
R2_ACCOUNT_ID=
# Opcionales: el proveedor ya da los valores correctos.
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# Sólo si el NAVEGADOR llega al almacenamiento por otra URL que el servidor
# (p. ej. la API habla con http://minio:9000 dentro de Docker).
S3_PUBLIC_ENDPOINT=
# Vida de las URL firmadas de descarga y subida, en segundos (30–3600).
STORAGE_URL_TTL_SECONDS=300


# =============================================================================
#  WHATSAPP BUSINESS CLOUD API                                   Fase 2
# -----------------------------------------------------------------------------
#  Vacío = el módulo queda DESACTIVADO, no roto: la interfaz muestra "canal sin
#  conectar" y el resto del CRM funciona con normalidad.
#
#  Para obtenerlos hace falta una cuenta de Meta Business VERIFICADA, y la
#  verificación puede tardar días o semanas. Conviene iniciarla cuanto antes.
#
#  Los tokens de cada empresa NO van aquí: se guardan cifrados en `channel`.
#  Esto son las credenciales de la APLICACIÓN de Meta, que es una sola.
# =============================================================================
META_APP_SECRET=
# Cadena que tú inventas y que también escribes en el panel de Meta al dar de
# alta el webhook. Meta la devuelve en la petición de verificación.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0


# =============================================================================
#  INTELIGENCIA ARTIFICIAL                                       Fase 3
# -----------------------------------------------------------------------------
#  Vacío = el módulo de IA queda desactivado. El resto no se entera.
#
#  El coste lo paga la plataforma antes de repercutirlo, así que cada empresa
#  tiene un techo mensual en `ai_setting.monthlyBudgetUsd` y se corta al
#  alcanzarlo.
# =============================================================================
OPENAI_API_KEY=


# =============================================================================
#  OBSERVABILIDAD
# =============================================================================
SENTRY_DSN=


# =============================================================================
#  WORKER
# =============================================================================
WORKER_CONCURRENCY=10
# Sonda de salud del worker (sólo 127.0.0.1): http://127.0.0.1:4100/health
WORKER_HEALTH_PORT=4100
